-- ============ Auto Ability logic ============
local lastReason
local function why(fmt, ...)
	if not cfg.DEBUG then return end
	local msg = (select("#", ...) > 0) and string.format(fmt, ...) or fmt
	if msg ~= lastReason then
		lastReason = msg
		print("[AA] " .. msg)
	end
end

-- sleeps up to t seconds; wakeNow() ends it early (timer is cancelled, nothing piles up)
local function sleep(t)
	local th = coroutine.running()
	local done = false
	local timer
	local function wake(fromTimer)
		if done then return end
		done = true
		wakeNow = nil
		if not fromTimer and timer then pcall(task.cancel, timer) end
		task.defer(th)
	end
	wakeNow = function() wake(false) end
	timer = task.delay(t, wake, true)
	coroutine.yield()
end

-- one permanent connection: cooldown changed -> wake the loop
track(lp:GetAttributeChangedSignal("AbilityReadyAt"):Connect(function()
	if wakeNow then wakeNow() end
end))

local function enemyInRange(origin)
	local folder = workspace:FindFirstChild("ActiveEnemies")
	if not folder then return false end
	for _, e in ipairs(folder:GetChildren()) do
		if e:GetAttribute("AIState") ~= "Dead" then
			local hrp = e:FindFirstChild("HumanoidRootPart")
			if hrp and (hrp.Position - origin).Magnitude <= cfg.RANGE then
				return true
			end
		end
	end
	return false
end

local function secondsUntilReady()
	local at = lp:GetAttribute("AbilityReadyAt")
	if type(at) ~= "number" then return 0 end
	return at + cfg.MARGIN - workspace:GetServerTimeNow()
end

local function tryCast()
	if cfg.REQUIRE_ARENA and lp:GetAttribute("InArena") ~= true then
		why("InArena = %s (Require Arena is on)", lp:GetAttribute("InArena"))
		return false
	end
	local ch = lp.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then why("no character / HumanoidRootPart") return false end
	if ch:GetAttribute("Downed") == true then why("character is Downed") return false end

	if cfg.MODE == "range" and not enemyInRange(hrp.Position) then
		why("no enemy within %d studs", cfg.RANGE)
		return false
	end

	-- no aiming: send the direction you are already facing
	local lv = hrp.CFrame.LookVector
	local flat = Vector3.new(lv.X, 0, lv.Z)
	if flat.Magnitude < 0.001 then flat = Vector3.new(0, 0, -1) end

	remote:FireServer(flat.Unit)
	lastReason = nil
	why("CAST (%s)", cfg.MODE)
	return true
end

local fails = 0 -- consecutive casts that did not change AbilityReadyAt (rejected?)

task.spawn(function()
	while alive do
		if not cfg.ENABLED then
			lastReason = nil
			sleep(1) -- idle: no polling, toggling wakes it instantly
		else
			local remaining = secondsUntilReady()
			if remaining > LEAD then
				why("ability on cooldown (waiting for AbilityReadyAt)")
				sleep(math.min(remaining - LEAD, MAX_SLEEP))
			elseif remaining > 0 then
				task.wait()
			else
				local before = lp:GetAttribute("AbilityReadyAt")
				local ok, casted = pcall(tryCast)
				if not ok then why("error: %s", casted) casted = false end
				if casted then
					sleep(RETRY_DELAY) -- woken early if the server starts the cooldown
					if lp:GetAttribute("AbilityReadyAt") == before then
						fails = math.min(fails + 1, 8)
						sleep(math.min(RETRY_DELAY * 2 ^ fails, 2)) -- back off, don't spam
					else
						fails = 0
					end
				else
					fails = 0
					sleep(IDLE_POLL)
				end
			end
		end
	end
end)

-- ============ Kill Aura logic ============
-- Runs only while the toggle is on: the RenderStepped connection is created on
-- enable and disconnected on disable. Inside it, every step costs one os.clock()
-- compare; the real work (scan + swing) happens once per AURA_COOLDOWN.
local lastAuraReason
local function whyAura(msg)
	if not cfg.DEBUG or msg == lastAuraReason then return end
	lastAuraReason = msg
	print("[KA] " .. msg)
end

local nextSwing = 0
local attackSeq = 0
local SCAN_INTERVAL = 0.1 -- enemy search runs ~10x/sec; facing still updates every frame
local nextScan = 0
local curTarget

-- nearest living enemy HumanoidRootPart within range, or nil
local function nearestEnemy(origin, range)
	local folder = workspace:FindFirstChild("ActiveEnemies")
	if not folder then return nil end
	local best, bestDist = nil, range
	for _, e in ipairs(folder:GetChildren()) do
		if e:GetAttribute("AIState") ~= "Dead" then
			local hrp = e:FindFirstChild("HumanoidRootPart")
			if hrp then
				local d = (hrp.Position - origin).Magnitude
				if d <= bestDist then
					best, bestDist = hrp, d
				end
			end
		end
	end
	return best
end

-- true if another player is downed within AURA_DOWNED_PAUSE studs of origin
local function downedNearby(origin)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local ch = p.Character
			if ch and ch:GetAttribute("Downed") == true then
				local hrp = ch:FindFirstChild("HumanoidRootPart")
				if hrp and (hrp.Position - origin).Magnitude <= AURA_DOWNED_PAUSE then
					return true
				end
			end
		end
	end
	return false
end

-- archers lead a moving target: offset the aim by the target's sideways
-- velocity (perpendicular to the line of sight), scaled by distance, capped
local function leadAim(target, origin)
	local pos = target.Position
	local vel = target.AssemblyLinearVelocity
	local flatVel = Vector3.new(vel.X, 0, vel.Z)
	local toTarget = pos - origin
	local flatTo = Vector3.new(toTarget.X, 0, toTarget.Z)
	if flatTo.Magnitude > 0 and flatVel.Magnitude > 1.5 then
		local dir = flatTo.Unit
		local lateral = flatVel - dir * flatVel:Dot(dir)
		if lateral.Magnitude > 1 then
			local offset = lateral * (toTarget.Magnitude / 180)
			if offset.Magnitude > AURA_MAX_LEAD then
				offset = offset.Unit * AURA_MAX_LEAD
			end
			pos = pos + offset
		end
	end
	return pos
end

local function auraTick()
	if lp:GetAttribute("InArena") == false then return end
	local ch = lp.Character
	if not ch or ch:GetAttribute("Downed") == true then return end
	local hrp = ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local now = os.clock()
	if not attackRemote then
		if now < nextSwing then return end
		attackRemote = remotes:FindFirstChild("Attack")
		releaseRemote = remotes:FindFirstChild("AttackRelease")
		if not attackRemote then
			whyAura("Remotes.Attack not found (retrying every 1s)")
			nextSwing = now + 1
			return
		end
	end

	local origin = hrp.Position
	local isArcher = lp:GetAttribute("Kit") == "Archer"

	-- search only ~10x/sec and remember the result
	if now >= nextScan then
		nextScan = now + SCAN_INTERVAL
		local range = isArcher and cfg.AURA_ARCHER or cfg.AURA_MELEE
		curTarget = nearestEnemy(origin, range)
	end

	-- every frame: keep using the remembered target while it is still alive
	local target = curTarget
	if not target then return end
	local model = target.Parent
	if not model or model:GetAttribute("AIState") == "Dead" then
		curTarget = nil
		nextScan = 0
		return
	end

	-- every frame: pause instantly while a downed player is close (revive window)
	if downedNearby(origin) then return end

	local aim = isArcher and leadAim(target, origin) or target.Position
	local toAim = aim - origin
	if toAim.Magnitude < 0.001 then return end

	-- face the target EVERY frame (smooth, like the reference script)
	if Vector3.new(toAim.X, 0, toAim.Z).Magnitude > 0.01 then
		hrp.CFrame = CFrame.lookAt(origin, Vector3.new(aim.X, origin.Y, aim.Z))
	end

	-- only the attack itself is throttled
	if now < nextSwing then return end
	nextSwing = now + AURA_COOLDOWN

	local dir = toAim.Unit
	attackSeq += 1
	if isArcher then
		attackRemote:FireServer(attackSeq, dir)
		if releaseRemote then releaseRemote:FireServer(attackSeq, 0, dir) end
	else
		attackRemote:FireServer(attackSeq, dir, false)
	end
end

local function auraStep()
	local ok, err = pcall(auraTick)
	if not ok then whyAura("error: " .. tostring(err)) end
end

-- idempotent: safe to call any time, never creates a second connection
local function applyKillAura()
	if cfg.KILL_AURA and alive then
		if not auraConn then
			nextSwing, nextScan, curTarget = 0, 0, nil
			auraConn = RunService.RenderStepped:Connect(auraStep)
		end
	elseif auraConn then
		auraConn:Disconnect()
		auraConn = nil
		lastAuraReason = nil
		curTarget = nil
	end
end

-- ============ Anti-AFK logic ============
-- Same method as the AbyssLooper script: a VirtualUser click every
-- AFK_INTERVAL seconds, far inside the ~20 min kick window. The thread only
-- exists while the toggle is on (handle stored, so no duplicates are possible).
local function afkClick()
	pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new(0, 0))
	end)
end

-- idempotent: the timer thread and the Idled hook exist only while the toggle is on
local function applyAntiAfk()
	if cfg.ANTI_AFK and alive then
		if not afkThread then
			afkThread = task.spawn(function()
				while alive do
					task.wait(AFK_INTERVAL)
					afkClick()
				end
			end)
		end
		if not idledConn then idledConn = lp.Idled:Connect(afkClick) end
	else
		if afkThread then pcall(task.cancel, afkThread) afkThread = nil end
		if idledConn then idledConn:Disconnect() idledConn = nil end
	end
end

-- ============ Position Lock logic ============
-- Anchors your root part where it is. Only the POSITION is held, so Kill Aura can
-- still turn your avatar. The Heartbeat step is one distance compare per frame and
-- only moves you back if something (server teleport, knockback) displaced you.
local function releaseLock()
	cfg.LOCK = false
	unlock()
	if refreshLock then refreshLock() end
end

local function lockStep()
	local hrp = lockHrp
	if not hrp or not hrp.Parent then releaseLock() return end
	if (hrp.Position - lockPos).Magnitude > 0.05 then
		hrp.CFrame = CFrame.new(lockPos) * hrp.CFrame.Rotation
	end
end

-- idempotent: never creates a second connection
local function applyLock()
	if cfg.LOCK and alive then
		if lockConn then return end
		local ch = lp.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if not hrp then releaseLock() return end
		lockHrp, lockPos = hrp, hrp.Position
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.Anchored = true
		lockConn = RunService.Heartbeat:Connect(lockStep)
	elseif lockConn or lockHrp then
		unlock()
	end
end

-- new character (respawn) -> lock is released, you choose when to lock again
track(lp.CharacterAdded:Connect(function()
	if lockConn then releaseLock() end
end))

