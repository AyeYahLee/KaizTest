local function makeSlider(page, labelTxt, key, fmt)
	local lim = LIMITS[key]
	local minV, maxV, step = lim.min, lim.max, lim.step
	local row = newRow(page, 54)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -80, 0, 22)
	lbl.Position = UDim2.fromOffset(10, 4)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelTxt
	lbl.TextColor3 = TEXT
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 13
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local box = Instance.new("TextBox")
	box.Size = UDim2.fromOffset(58, 22)
	box.Position = UDim2.new(1, -66, 0, 4)
	box.BackgroundColor3 = Color3.fromRGB(14, 14, 20)
	box.TextColor3 = ACCENT
	box.Font = Enum.Font.GothamBold
	box.TextSize = 13
	box.ClearTextOnFocus = true
	box.BorderSizePixel = 0
	box.Parent = row
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

	local hit = Instance.new("Frame")
	hit.Size = UDim2.new(1, -20, 0, 24)
	hit.Position = UDim2.fromOffset(10, 28)
	hit.BackgroundTransparency = 1
	hit.Active = true
	hit.Parent = row

	local track_ = Instance.new("Frame")
	track_.Size = UDim2.new(1, 0, 0, 6)
	track_.Position = UDim2.new(0, 0, 0.5, -3)
	track_.BackgroundColor3 = OFFCOL
	track_.BorderSizePixel = 0
	track_.Parent = hit
	Instance.new("UICorner", track_).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = ACCENT
	fill.BorderSizePixel = 0
	fill.Parent = track_
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local function apply(v, silent)
		v = math.clamp(v, minV, maxV)
		v = math.floor(v / step + 0.5) * step
		v = math.clamp(v, minV, maxV)
		cfg[key] = v
		fill.Size = UDim2.new((v - minV) / (maxV - minV), 0, 1, 0)
		box.Text = string.format(fmt, v)
		if not silent then scheduleSave() end
	end
	apply(cfg[key], true)

	local function fromX(x)
		local pct = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
		apply(minV + pct * (maxV - minV))
	end

	track(hit.InputBegan:Connect(function(i)
		if not isPress(i) then return end
		page.ScrollingEnabled = false
		lockedPage = page
		fromX(i.Position.X)
		beginDrag(i, function(pos) fromX(pos.X) end)
	end))

	track(box.FocusLost:Connect(function()
		local v = tonumber(box.Text)
		if v then apply(v) else box.Text = string.format(fmt, cfg[key]) end
	end))
end

