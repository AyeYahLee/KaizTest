-- ============ bookkeeping ============
-- every handle that stop() must clean up is declared HERE, above stop(),
-- so stop() sees them as upvalues instead of globals
local alive = true
local conns = {}
local gui, main, icon, wakeNow
local auraConn, afkThread, idledConn
local boonThread, applyBoon
local boonConns = {}
local lockConn, lockHrp, lockPos, refreshLock
local saveThread, dirty = nil, false
local function track(c) conns[#conns + 1] = c return c end

-- releases the position lock (safe to call any time, even when not locked)
local function unlock()
	if lockConn then lockConn:Disconnect() lockConn = nil end
	if lockHrp then
		if lockHrp.Parent then lockHrp.Anchored = false end
		lockHrp = nil
	end
	lockPos = nil
end

local function isNum(v)
	return type(v) == "number" and v == v and math.abs(v) < 1e5
end

-- ============ saving (features only) ============
local canFS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"

local function save()
	if not canFS then return end
	local data = {}
	for _, k in ipairs(SAVE_KEYS) do data[k] = cfg[k] end
	pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(SAVE_DIR) then
			makefolder(SAVE_DIR)
		end
		writefile(SAVE_FILE, HttpService:JSONEncode(data))
	end)
end

-- at most one write per second, always saves the latest state
local function scheduleSave()
	if not alive then return end
	dirty = true
	if saveThread then return end
	saveThread = task.delay(1, function()
		saveThread = nil
		if alive and dirty then
			dirty = false
			save()
		end
	end)
end

-- ============ full cleanup ============
local function stop()
	if not alive then return end
	alive = false
	if saveThread then pcall(task.cancel, saveThread) saveThread = nil end
	if dirty then dirty = false save() end
	if auraConn then auraConn:Disconnect() auraConn = nil end
	if afkThread then pcall(task.cancel, afkThread) afkThread = nil end
	if idledConn then idledConn:Disconnect() idledConn = nil end
	if boonThread then pcall(task.cancel, boonThread) boonThread = nil end
	for _, c in ipairs(boonConns) do pcall(function() c:Disconnect() end) end
	table.clear(boonConns)
	unlock()
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	table.clear(conns)
	if wakeNow then pcall(wakeNow) end
	if gui then gui:Destroy() end
	if env.GB_AUTOABILITY_STOP == stop then env.GB_AUTOABILITY_STOP = nil end
end
-- registered BEFORE anything can yield, so a fast re-execute always finds it
