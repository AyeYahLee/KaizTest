-- Background Auto Hatch Executor
-- getIncubatorState reads on-screen GUI text, which doesn't reliably
-- update/stream when far from the incubators. Since ClientHatchStart /
-- ClientHatchTaken have no actual distance restriction (confirmed working
-- from another island), we track state ourselves instead of reading the
-- GUI.
--
-- Optimization: we don't know whether resending ClientHatchStart to a
-- slot that's already hatching wastes an egg, and hatch durations are
-- random so we can't just wait "long enough" to be safe. Instead we only
-- ever send Start right after a Claim succeeds on that same slot — i.e.
-- we only start a slot we just emptied ourselves, never blind-restart a
-- slot we're merely guessing is empty. incubatorKnownEmpty tracks which
-- slots we're confident are actually empty right now.
-- Shared read of the game's egg accessor object (GamePlayer.egg) -- the same
-- object the hatch channels validate against (per the EggSystem decompile).
-- Returns nil when unreadable so every caller can degrade gracefully.
local function noxarGameEgg()
    local gp = getGamePlayer()
    if gp and gp.egg then return gp.egg end
    return nil
end

-- How many of one egg template sit in the bag. nil = couldn't read; callers
-- must treat nil as "unknown" (fire anyway, the server is the real guard).
function noxarGetEggAmount(eggId)
    local egg = noxarGameEgg()
    if not egg or not egg.GetEggAmount then return nil end
    local okAmount, amount = pcall(function() return egg:GetEggAmount(eggId) end)
    if okAmount and type(amount) == "number" then return amount end
    return nil
end

-- Whether an incubator slot is unlocked. nil = couldn't read.
function noxarIsHatchUnlocked(idx)
    local egg = noxarGameEgg()
    if not egg or not egg.IsHatchUnlocked then return nil end
    local okU, unlocked = pcall(function() return egg:IsHatchUnlocked(idx) end)
    if okU then return unlocked and true or false end
    return nil
end

-- Tmpl id of the egg currently incubating in a slot (nil = empty or the
-- read failed). Used for the hatch loop's idle status ("waiting on X/5").
function noxarGetHatchSlotTmpl(idx)
    local egg = noxarGameEgg()
    if not egg or not egg.GetHatchEggTmplId then return nil end
    local okT, tmpl = pcall(function() return egg:GetHatchEggTmplId(idx) end)
    if okT then return tmpl end
    return nil
end

incubatorKnownEmpty = {} -- [index] = true once we've either claimed it or confirmed it empty

-- One-time pass: try Start on every slot once at startup, in case some
-- are sitting empty from before the script ran (e.g. after a rejoin).
hatchBootstrapped = false


spawnTracked("autoHatchLoop", function()
    while task.wait(3) do
        if not autoHatchEnabled or not selectedEggId then continue end

        -- First pass ever: seed every slot as a Start candidate so
        -- slots left empty from before we started still get filled.
        if not hatchBootstrapped then
            hatchBootstrapped = true
            for i = 1, 5 do incubatorKnownEmpty[i] = true end
        end

        -- Live stock check, straight from the game's own egg data. nil =
        -- couldn't read (don't gate on it). When the bag is out of the
        -- chosen egg we skip the Start burns entirely and say why — and
        -- since slots stay flagged empty, hatching RESUMES by itself the
        -- moment you farm more of the egg.
        local eggAmount = noxarGetEggAmount(selectedEggId)
        local noEggsLeft = (eggAmount ~= nil and eggAmount <= 0)

        -- Tracks whether an event this pass already wrote the status label;
        -- if nothing did, the end-of-cycle idle refresh fills it in so the
        -- label can never sit frozen on a stale "Hatching ..." for hours.
        local labelTouched = false

        for incubatorIndex = 1, 5 do
            if not autoHatchEnabled then break end

            -- Claim: read the REAL outcome. pcall-ok only means "no Lua
            -- error" — the channel also returns plain `false` for a
            -- normal "nothing ready/empty slot" (ignore quietly) and
            -- `false + reason` when the take is blocked (pet bag full).
            local okClaim, c1, c2 = pcall(function()
                if EggSystem then
                    return EggSystem.ClientHatchTaken(incubatorIndex)
                else
                    return DataPullFunc:InvokeServer("EggHatchTakenChannel", incubatorIndex)
                end
            end)
            if okClaim and c1 ~= false then
                -- Actually took a pet: the slot is truly empty now.
                incubatorKnownEmpty[incubatorIndex] = true
                HatchStatusLbl.Text = "Status: Collected pet from incubator " .. tostring(incubatorIndex)
                HatchStatusLbl.TextColor3 = C.green
                labelTouched = true
            elseif okClaim and c2 then
                if tostring(c2):find("SlotsFull") then
                    HatchStatusLbl.Text = "⚠ Pet bag is full — release or fuse pets to keep hatching"
                else
                    HatchStatusLbl.Text = "⚠ Incubator " .. tostring(incubatorIndex) .. " collect rejected: " .. tostring(c2)
                end
                HatchStatusLbl.TextColor3 = C.gold
                labelTouched = true
            end
            task.wait(0.2)

            -- Only Start a slot we know is actually empty (either
            -- just claimed above, or seeded on the first pass) —
            -- never blind-restart a slot that might already be
            -- hatching.
            if incubatorKnownEmpty[incubatorIndex] and not noEggsLeft then
                local okStart, s1 = pcall(function()
                    if EggSystem then
                        return EggSystem.ClientHatchStart(incubatorIndex, selectedEggId)
                    else
                        return DataPullFunc:InvokeServer("EggHatchStartChannel", incubatorIndex, selectedEggId)
                    end
                end)
                if okStart and s1 ~= false then
                    HatchStatusLbl.Text = "Status: Hatching " .. tostring(selectedEggName) .. " (incubator " .. tostring(incubatorIndex) .. ")"
                    HatchStatusLbl.TextColor3 = C.green
                else
                    local lockHint = ""
                    if noxarIsHatchUnlocked(incubatorIndex) == false then
                        lockHint = " — that incubator may still be locked"
                    end
                    HatchStatusLbl.Text = "⚠ Incubator " .. tostring(incubatorIndex) .. " rejected the egg" .. lockHint
                    HatchStatusLbl.TextColor3 = C.gold
                end
                labelTouched = true
                -- Whether it started or got rejected, stop treating
                -- the slot as empty until a real claim marks it
                -- again (a rejected slot isn't safe to retry-loop).
                incubatorKnownEmpty[incubatorIndex] = nil
                task.wait(0.2)
            end
        end

        -- End-of-cycle idle refresh: if no event this pass wrote a status,
        -- show the live waiting state instead of leaving an old message
        -- (e.g. "Hatching ..." from hours ago) frozen on screen.
        if not labelTouched then
            if noEggsLeft then
                HatchStatusLbl.Text = "Status: No " .. tostring(selectedEggName) .. " left — farm more and hatching will resume by itself"
                HatchStatusLbl.TextColor3 = C.gold
            else
                local busySlots = 0
                for i = 1, 5 do
                    if noxarGetHatchSlotTmpl(i) ~= nil then busySlots = busySlots + 1 end
                end
                if busySlots > 0 then
                    HatchStatusLbl.Text = "Status: Waiting for hatches — " .. tostring(busySlots) .. "/5 eggs incubating"
                else
                    HatchStatusLbl.Text = "Status: Idle — no eggs incubating"
                end
                HatchStatusLbl.TextColor3 = Color3.fromRGB(205, 215, 245)
            end
        end
    end
end)

