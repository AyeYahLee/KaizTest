-- SHUTDOWN TEARDOWN (replaces the old Close-X handler)
-- ==========================================
-- WindUI's Window:Destroy() fires OnDestroy and wipes the whole UI. This runs
-- the same full teardown the old panel's X button did. The identity check
-- (_G.NoxarWindLib == myLib below) makes sure a *script re-execution*
-- destroying an older window does NOT also kill the new run's state.
function shutdownNoxarHub()
    running = false
    riftRunning = false
    autoAbyssEnabled = false
    legitModeEnabled = false
    _G.NoxarRiftLoopGeneration = (_G.NoxarRiftLoopGeneration or 0) + 1
    _G.NoxarAbyssLoopGeneration = (_G.NoxarAbyssLoopGeneration or 0) + 1
    riftPhase = "IDLE"
    riftHealingInProgress = false
    riftRiftSearchPausedUntil = 0
    riftPostRiftTransition = false
    runId += 1
    unequipAll()

    bossLoopEnabled = false
    table.clear(bossQueue)
    currentBossFight = nil
    pcall(function() _G.NoxarSetBossMount(false, true) end)

    cancelAllTrackedThreads()
    disconnectAllTrackedConnections()

    _G.NoxarBossMountState = nil
    _G.NoxarSetBossMount = nil
    local debugFolder = workspace:FindFirstChild("NoxarRiftHealDebug")
    if debugFolder then debugFolder:Destroy() end
end

do
    local myLib = WindUI
    Window:OnDestroy(function()
        if _G.NoxarWindLib == myLib then
            _G.NoxarWindLib = nil
            shutdownNoxarHub()
