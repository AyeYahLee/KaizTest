function NoxarAutoCatchGetModelPosition(model)
    if not model then return nil end

    local okRoot, root = pcall(function()
        return model:FindFirstChild("Root") or model.PrimaryPart
    end)
    if okRoot and root then
        local okBasePart, isBasePart = pcall(function()
            return root:IsA("BasePart")
        end)
        if okBasePart and isBasePart then
            return root.Position
        end
    end

    local ok, cf = pcall(function()
        return model:GetPivot()
    end)
    if ok and cf then
        return cf.Position
    end
    return nil
end

function NoxarAutoCatchGetInfoPosition(info)
    if not info then return nil end
    if info.CurrentCFrame then return info.CurrentCFrame.Position end
    if info.CFrame then return info.CFrame.Position end
    if info.Position then return info.Position end
    if info.Model then return NoxarAutoCatchGetModelPosition(info.Model) end
    return nil
end

function NoxarAutoCatchInfoMatchesMonster(info, monster)
    if not info or not monster or not info.Model then return false end
    if info.Model == monster then return true end
    local ok, result = pcall(function()
        return info.Model:IsDescendantOf(monster) or monster:IsDescendantOf(info.Model)
    end)
    return ok and result == true
end

function NoxarGetVisibleCatchInfoForMonster(monster)
    local mgr = NoxarGetMgrMonsterClient()
    if not mgr or type(mgr.GetShowCatchInfo) ~= "function" then return nil end

    local ok, info = pcall(function()
        return mgr.GetShowCatchInfo()
    end)
    if not ok or not info or not info.MonsterId then return nil end

    pcall(function() info.__source = "visible prompt" end)
    if not monster then return info end
    if NoxarAutoCatchInfoMatchesMonster(info, monster) then return info end

    local targetPos = NoxarAutoCatchGetModelPosition(monster)
    local infoPos = NoxarAutoCatchGetInfoPosition(info)
    if targetPos and infoPos and (targetPos - infoPos).Magnitude <= 120 then
        return info
    end

    return nil
end

-- V6-style one-shot catch straight from an already-found catch info:
-- MonsterCatchStartChannel -> CatchResult -> MonsterCatchUtil.StartCatch(...)
-- immediately; MonsterCatchUtil then completes the animated catch on its own
-- (no waiting, no state bookkeeping, no player movement/teleports).
function NoxarStartCatchFromInfo(info)
    if not info or not info.MonsterId then
        return false, nil, "no catch info"
    end

    local monsterId = tonumber(info.MonsterId)
    if not monsterId then
        return false, nil, "invalid MonsterId"
    end

    local okStart, ret1, ret2, ret3 = pcall(function()
        return DataPullFunc:InvokeServer("MonsterCatchStartChannel", monsterId)
    end)
    if not okStart then
        return false, monsterId, "start error"
    end
    if ret1 == false then
        return false, monsterId, "start rejected"
    end

    local result = NoxarExtractCatchResult(ret1, ret2, ret3)
    if not result then
        return false, monsterId, "no CatchResult"
    end

    -- MonsterCatchUtil uses PathTool.MonsterSystem when it completes the
    -- local catch animation, so load/cache both before StartCatch.
    NoxarGetMonsterSystem()
    local util = NoxarGetMonsterCatchUtil()
    if not util or type(util.StartCatch) ~= "function" then
        return false, monsterId, "catch util unavailable"
    end

    local catchPos = result.CFrame and result.CFrame.Position
        or NoxarAutoCatchGetInfoPosition(info)
        or Vector3.zero

    local okAnim = pcall(function()
        util.StartCatch(catchPos, monsterId, result)
    end)
    if not okAnim then
        return false, monsterId, "animation error"
    end

    return true, monsterId, "started"
end

-- V6-style nearby catchable scan for Auto Farm: collects every catch info
-- the game currently reports (visible catch prompt first, then the game's
-- can-catch list) that maps to a FILTERED, still-alive ClientMonsters model
-- within `radius` studs of the PLAYER. Pure detection -- it never moves the
-- character. Returns { { info = ..., model = ..., monsterId = ... }, ... }.
function NoxarFindNearbyCatchableInfos(radius)
    local found, seen = {}, {}
    local root = getRoot()
    if not root then return found end
    local rootPos = root.Position
    radius = tonumber(radius) or NEARBY_CATCH_RADIUS

    local function tryAdd(info)
        if not info or not info.MonsterId then return end
        local monsterId = tonumber(info.MonsterId)
        if not monsterId or seen[monsterId] then return end

        -- map info -> the live ClientMonsters child (attack naming:
        -- "Monster_<id>"; fall back to climbing info.Model's ancestry)
        local model = clientMonsters:FindFirstChild("Monster_" .. tostring(monsterId))
        if not model and info.Model then
            pcall(function()
                local node = info.Model
                while node and node ~= clientMonsters and node.Parent ~= clientMonsters do
                    node = node.Parent
                end
                if node and node.Parent == clientMonsters then
                    model = node
                end
            end)
        end
        if not model then return end

        -- same name filter as the attack targeting (getTargetMonsters)
        local mInfo = nameCache[model.Name]
        local displayName = (mInfo and mInfo.name) or model.Name
        if selectedMonster and not displayName:lower():find(selectedMonster:lower(), 1, true) then
            return
        end

        local pos = NoxarAutoCatchGetModelPosition(model) or NoxarAutoCatchGetInfoPosition(info)
        if not pos or (pos - rootPos).Magnitude > radius then return end

        seen[monsterId] = true
        table.insert(found, { info = info, model = model, monsterId = monsterId })
    end

    local mgr = NoxarGetMgrMonsterClient()

    -- 1) the currently shown catch prompt (V6 checks it first)
    if mgr and type(mgr.GetShowCatchInfo) == "function" then
        local ok, info = pcall(function()
            return mgr.GetShowCatchInfo()
        end)
        if ok then tryAdd(info) end
    end

    -- 2) the game's own can-catch list
    if mgr and type(mgr.IterSelfCanCatchBattleMonster) == "function" then
        pcall(function()
            mgr.IterSelfCanCatchBattleMonster(function(info)
                tryAdd(info)
            end)
        end)
    end

    return found
end

function NoxarGetNearestCatchInfoFromMgr(monster)
    local mgr = NoxarGetMgrMonsterClient()
    if not mgr or type(mgr.IterSelfCanCatchBattleMonster) ~= "function" then return nil end

    local targetPos = NoxarAutoCatchGetModelPosition(monster)
    local bestInfo, bestDist, exactInfo, onlyInfo = nil, math.huge, nil, nil
    local count = 0

    pcall(function()
        mgr.IterSelfCanCatchBattleMonster(function(info)
            if not info or not info.MonsterId then return end
            count += 1
            onlyInfo = info

            if monster and NoxarAutoCatchInfoMatchesMonster(info, monster) then
                exactInfo = info
                return
            end

            local infoPos = NoxarAutoCatchGetInfoPosition(info)
            if targetPos and infoPos then
                local dist = (targetPos - infoPos).Magnitude
                if dist < bestDist then
                    bestInfo = info
                    bestDist = dist
                end
            end
        end)
    end)

    if exactInfo then
        pcall(function() exactInfo.__source = "catchable exact" end)
        return exactInfo
    end
    if bestInfo and (not monster or not targetPos or bestDist <= 120) then
        pcall(function() bestInfo.__source = "catchable nearest" end)
        return bestInfo
    end
    if count == 1 and onlyInfo and (not monster or not targetPos) then
        pcall(function() onlyInfo.__source = "catchable only" end)
        return onlyInfo
    end

    return nil
end

function NoxarFindCatchInfoForMonster(monster)
    return NoxarGetNearestCatchInfoFromMgr(monster)
        or NoxarGetVisibleCatchInfoForMonster(monster)
end

function NoxarExtractCatchResult(a, b, c)
    if type(a) == "table" then return a end
    if type(b) == "table" then return b end
    if type(c) == "table" then return c end
    return nil
end

function NoxarStartAutoCatchForMonster(monster)
    NoxarCleanupAutoCatchState()

    local info = NoxarFindCatchInfoForMonster(monster)
    if not info or not info.MonsterId then
        return false, nil, "no catchable target"
    end

    local monsterId = tonumber(info.MonsterId)
    if not monsterId then
        NoxarCleanupAutoCatchState()
        return false, nil, "invalid MonsterId"
    end

    NoxarAutoCatchState.activeMonsterId = monsterId
    NoxarAutoCatchState.activeToken = os.clock()
    NoxarAutoCatchState.lastInfo = info

    local okStart, ret1, ret2, ret3 = pcall(function()
        return DataPullFunc:InvokeServer("MonsterCatchStartChannel", monsterId)
    end)
    if not okStart then
        NoxarCleanupAutoCatchState()
        return false, monsterId, "start error"
    end
    if ret1 == false then
        NoxarCleanupAutoCatchState()
        return false, monsterId, "start rejected"
    end

    local result = NoxarExtractCatchResult(ret1, ret2, ret3)
    if not result then
        NoxarCleanupAutoCatchState()
        return false, monsterId, "no CatchResult"
    end

    -- MonsterCatchUtil uses PathTool.MonsterSystem when it completes the local
    -- catch animation, so load/cache both before StartCatch.
    NoxarGetMonsterSystem()
    local util = NoxarGetMonsterCatchUtil()
    if not util or type(util.StartCatch) ~= "function" then
        NoxarCleanupAutoCatchState()
        return false, monsterId, "catch util unavailable"
    end

    local catchPos = result.CFrame and result.CFrame.Position
        or NoxarAutoCatchGetInfoPosition(info)
        or NoxarAutoCatchGetModelPosition(monster)
        or Vector3.zero

    local okAnim = pcall(function()
        util.StartCatch(catchPos, monsterId, result)
    end)
    if not okAnim then
        NoxarCleanupAutoCatchState()
        return false, monsterId, "animation error"
    end

    return true, monsterId, "started"
end

-- Monster model -> its data MonsterId (same extraction the attack call uses).
function noxarMonsterIdFromModel(monster)
    if not monster then return nil end
    local okName, byName = pcall(function()
        return tonumber(monster.Name:match("Monster_(%d+)"))
    end)
    if okName and byName then return byName end
    local okAttr, byAttr = pcall(function()
        return tonumber(monster:GetAttribute("MonsterId"))
    end)
    if okAttr then return byAttr end
    return nil
end

-- Game-faithful per-monster catch state, read from the boss's ServerNode
-- attributes -- the exact signals the in-game Auto feature
-- (AutoAttackUtil._searchAutoCatch) and the MonsterCatchStartChannel
-- validation both use:
--   "catchable" = CatchPlayerId_<my user id> present (we are eligible, and no
--                 one has claimed it)
--   "claimed"   = CatchTakenPlayerId (or per-player CatchTakenPlayerId_<id>)
--                 present -- set the INSTANT any catch start is accepted,
--                 no matter who fired it (us, in-game Auto, another player)
--   "gone"      = the monster info is gone (CatchComplete destroyed it)
--   "pending"   = monster exists but none of the above (alive / not eligible)
--   nil         = unreadable (manager/info unavailable) -- callers fall back
--                 to legacy behavior
function noxarReadMonsterCatchState(monsterId)
    local mgr = NoxarGetMgrMonsterClient()
    if not mgr or type(mgr.GetMonsterInfo) ~= "function" then return nil end
    local okInfo, info = pcall(mgr.GetMonsterInfo, monsterId)
    if not okInfo then return nil end
    if info == nil then return "gone" end
    local node = info.ServerNode
    if node == nil then return nil end

    local okT, taken = pcall(function() return node:GetAttribute("CatchTakenPlayerId") end)
    if okT and taken ~= nil then return "claimed" end

    local lp = game.Players and game.Players.LocalPlayer
    local uid = lp and lp.UserId
    if uid then
        local okPT, takenMine = pcall(function() return node:GetAttribute("CatchTakenPlayerId_" .. uid) end)
        if okPT and takenMine ~= nil then return "claimed" end
        local okE, eligible = pcall(function() return node:GetAttribute("CatchPlayerId_" .. uid) end)
        if okE and eligible ~= nil then return "catchable" end
    end
    return "pending"
end

function NoxarAutoCatchWaitProcessed(monster, label, statusFn, keepRunningFn, canTryFn, startWait, doneWait, attackFn, externalDoneFn, canStartFn)
    local maxStartWait = tonumber(startWait)
    local waitUntilStarted = (not maxStartWait) or maxStartWait <= 0
    doneWait = tonumber(doneWait) or 1
    label = tostring(label or "Monster")

    local started, monsterId, message = false, nil, nil
    local externalDone = nil
    local startAt = os.clock()
    local lastAttackAt = 0

    while waitUntilStarted or os.clock() - startAt < maxStartWait do
        if keepRunningFn and not keepRunningFn() then
            NoxarCleanupAutoCatchState()
            return false, "stopped"
        end
        if canTryFn and not canTryFn() then
            NoxarCleanupAutoCatchState()
            return false, "target unavailable"
        end

        -- The catch may be started/finished by something other than us --
        -- the in-game Auto battle feature, or another player. Boss callers
        -- pass externalDoneFn to notice that (boss gone / death notified);
        -- rift callers pass nothing and their behavior is unchanged.
        if externalDoneFn then
            local okExt, done, why = pcall(externalDoneFn)
            if okExt and done then
                externalDone = tostring(why or "external")
                break
            end
        end

        -- Optional "attack while waiting for the catch window" hook (Ultra
        -- boss fights). Runs at farm attack cadence until the catch starts;
        -- rift callers simply don't pass it, so that path is unchanged.
        if attackFn and os.clock() - lastAttackAt >= math.max(ATTACK_DELAY or 0.15, 0.15) then
            lastAttackAt = os.clock()
            pcall(attackFn)
        end

        -- Optional game-faithful catch-window gate (special boss fights):
        -- only fire MonsterCatchStartChannel once the boss's ServerNode
        -- marks us an eligible catcher -- the same gate the in-game Auto
        -- feature uses -- instead of blind-spamming a remote the server
        -- keeps rejecting. nil gate = legacy blind attempts (rift path).
        local mayStart = true
        if canStartFn then
            local okGate, allowed = pcall(canStartFn)
            mayStart = okGate and allowed and true or false
        end
        if mayStart then
            started, monsterId, message = NoxarStartAutoCatchForMonster(monster)
            if started then break end
        else
            message = "boss not catchable yet"
        end

        if statusFn then
            local elapsed = math.floor(os.clock() - startAt)
            if attackFn then
                -- Ultra boss fights attack while camping the catch window --
                -- say so, otherwise the status looks like we are just standing
                -- there doing nothing.
                statusFn("Status: Attacking " .. label .. "... waiting for catch window (" .. tostring(elapsed) .. "s)"
                    .. (message and (" — " .. tostring(message)) or ""), C.gold)
            else
                local waitText = waitUntilStarted and ("waiting... " .. tostring(elapsed) .. "s") or "waiting..."
                statusFn("Status: " .. label .. " Auto Catch " .. waitText .. " " .. tostring(message or "not ready"), C.gold)
            end
        end
        task.wait(0.25)
    end

    if not started and not externalDone then
        NoxarCleanupAutoCatchState()
        if statusFn then
            statusFn("Status: " .. label .. " Auto Catch did not start" .. (message and (" (" .. tostring(message) .. ")") or ""), C.red)
        end
        return false, message or "not started"
    end

    if statusFn then
        if externalDone then
            statusFn("Status: " .. label .. " catch finished (" .. externalDone .. ") — processing...", C.green)
        else
            statusFn("Status: " .. label .. " Auto Catch started — processing...", C.green)
        end
    end

    local doneAt = os.clock() + doneWait
    while os.clock() < doneAt do
        if keepRunningFn and not keepRunningFn() then
            NoxarCleanupAutoCatchState()
            return false, "stopped"
        end
        task.wait(math.min(0.1, math.max(0, doneAt - os.clock())))
    end

    NoxarCleanupAutoCatchState()
    if statusFn then
        statusFn("Status: " .. label .. " processed.", C.green)
    end
    return true, "processed", monsterId
end

-- Clear any leftover per-catch state from a previous script run before the rest of
-- the script continues.
