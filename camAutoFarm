-- Same visual grade letters the old breeding list used.
local function noxarBreedRank(grade)
    if grade == 1 then return "E" end
    if grade == 2 then return "D" end
    if grade == 3 then return "C" end
    if grade == 4 then return "B" end
    if grade == 5 then return "A" end
    if grade == 6 then return "S" end
    if grade == 7 then return "SS" end
    return tostring(grade or "?")
end

function noxarBreedValues(kind)
    local males, females = scanBreedablePets()
    local list = (kind == "father") and males or females
    local values = {}
    for _, entry in ipairs(list) do
        table.insert(values, entry.name .. "  [" .. noxarBreedRank(entry.grade) .. "]  ·  ID " .. tostring(entry.id))
    end
    if #values == 0 then
        table.insert(values, "(no eligible " .. (kind == "father" and "male" or "female") .. " pets found)")
    end
    return values
end

function noxarParseBreedValue(v)
    local name, id = v:match("^(.-)%s*%[.-%]%s*·%s*ID%s*(%d+)$")
    return name, tonumber(id)
end

