-- NoxarElm is our element registry (WindUI setters are per-element; there is
-- no global Options table; each element keeps its own :Set/:Select). Ids are
-- stable strings so the wire-up reads the same everywhere.
NoxarElm = {}

-- uiReady guards every Callback below: WindUI fires each dropdown's/input's
-- callback once at creation with its default value, which would run logic
-- before everything exists (and double-start loops). Callbacks no-op until
-- the whole UI is built; the resume blocks at the bottom of the file handle
-- anything that should auto-start from the last session.
uiReady = false

-- NoxarSync guards programmatic refresh/set calls so they don't retrigger the
-- same callback (used for mutually exclusive toggles, reverting a toggle, and
-- silent dropdown list rebuilds).
NoxarSync = false
function syncOption(idx, v)
    local elm = NoxarElm[idx]
    if not elm then return end
    NoxarSync = true
    pcall(function()
        if elm.__type == "Toggle" then
            elm:Set(v, false) -- WindUI: Set(value, isCallback) -> silent
        elseif elm.__type == "Dropdown" then
            elm:Select(v) -- fires via Refresh; the NoxarSync gate stops our handler
        else
            elm:Set(v) -- Inputs always fire; the NoxarSync gate stops our handler
        end
    end)
    NoxarSync = false
end
function noxarCallbackGate()
    return (not uiReady) or NoxarSync
end

-- Silent list rebuild: WindUI's Dropdown:Refresh re-fires the Callback with
-- the current selection; wrapping it keeps our state untouched while the
-- visible options change (same semantics as the old dropdown SetValues).
function noxarRefreshDropdown(drop, values)
    NoxarSync = true
    pcall(function() drop:Refresh(values) end)
    NoxarSync = false
end

-- makeStatusLabel(element, initial) -> proxy that accepts the same `.Text =
-- "..."` writes the old TextLabels got from the logic loops. Every existing
-- status write in the kept logic (RiftStatusLbl.Text = ..., etc.) keeps
-- working unchanged. Color writes (TextColor3) are ignored; WindUI themes text.
function makeStatusLabel(element, initial)
    local current = initial or ""
    return setmetatable({}, {
        __newindex = function(_, k, v)
            if k == "Text" then
                current = tostring(v)
                pcall(function() element:SetDesc(current) end)
            end
        end,
        __index = function(_, k)
            if k == "Text" then
                return current
            end
            return nil
        end
    })
end

