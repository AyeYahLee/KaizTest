_G.NoxarAbyssLoopGeneration = (_G.NoxarAbyssLoopGeneration or 0) + 1

-- Check if player is currently inside an Abyss area
local function isInAbyssArea()
    local ok, areaId = pcall(function()
        local PT = _G.PathTool or getPathToolSafe()
        return PT and PT.AreaUtil and PT.AreaUtil.GetLocalPlayerAreaId()
    end)
    if not ok or not areaId then return false, nil end

    local isAbyss = false
    pcall(function()
        local PT = _G.PathTool or getPathToolSafe()
        isAbyss = PT and PT.CfgGlobal and PT.CfgGlobal.AreaIdIsAbyss(areaId)
    end)
    return isAbyss, areaId
end

-- Get the current Abyss sync key (nil if not in Abyss)
local function getAbyssSyncKey()
    local ok, key = pcall(function() return LP:GetAttribute("AbyssSyncKey") end)
    return ok and key or nil
end

-- Safely read a DataSyncUtil value
local function getAbyssSyncValue(syncKey, path)
    local ok, val = pcall(function()
        local PT = _G.PathTool or getPathToolSafe()
        local DSU = PT and PT.DataSyncUtil
        if DSU and DSU.GetValue then
            return DSU.GetValue(syncKey, path)
        end
        return nil
    end)
    return ok and val or nil
end

-- Pick the best door from DoorInfos based on room type preference
-- Get the actual reward key for a door using its ExtraWinRewardSeed
-- This replicates exactly what the game does to determine each door's reward
local function getDoorRewardKey(door, PT)
    local roomTmpls = PT.CfgAbyss and PT.CfgAbyss.RoomTmpls
    local roomTypes = PT.CfgAbyss and PT.CfgAbyss.RoomTypes
    if not roomTmpls or not roomTypes then return nil end

    local tmpl = roomTmpls[door.RoomId]
    if not tmpl then return nil end

    local rtCfg = roomTypes[tmpl.RoomType]
    if not rtCfg then return "Tp_" .. tostring(tmpl.RoomType) end

    -- Try seed-based reward generation (same as the game uses)
    if door.ExtraWinRewardSeed and rtCfg.ExtraWinReward then
        local ok, rewardList = pcall(function()
            local applied = PT.CfgAbyssUtil.ApplyExtraWinReward(rtCfg.ExtraWinReward, tmpl)
            local result = {}
            PT.RewardSystem.__DoRewardGroup(nil, applied, result, Random.new(door.ExtraWinRewardSeed), false, true)
            return result
        end)
        if ok and rewardList and #rewardList > 0 then
            local reward = rewardList[1]
            if reward.RewardRes == "CommonItem" then
                return "Rwd_CommonItem_" .. tostring(reward.TmplId)
            elseif reward.RewardRes == "Value" then
                return "Rwd_Value_" .. tostring(reward.ValueType)
            elseif reward.RewardRes == "PetExpItem" then
                return "Rwd_PetExpItem_" .. tostring(reward.TmplId)
            end
        end
    end

    -- Fallback: room type key
    return "Tp_" .. tostring(tmpl.RoomType)
end

-- Pick the best door using the game's saved Reward Priority
local function pickPreferredDoor(doorInfos)
    if not doorInfos or #doorInfos == 0 then return nil end

    local PT = _G.PathTool or getPathToolSafe()
    if not PT then
        for _, door in ipairs(doorInfos) do
            if door.Opened then return door end
        end
        return nil
    end

    local gp = getGamePlayer()
    local abyssPlayer = gp and gp.abyss

    local bestDoor = nil
    local bestPriority = -math.huge

    for _, door in ipairs(doorInfos) do
        if door.Opened then
            local roomKey = getDoorRewardKey(door, PT)
            local priority = 0

            if roomKey and abyssPlayer then
                local savedPri = abyssPlayer:GetRoomPriority(roomKey)
                if savedPri and savedPri ~= 0 then
                    priority = savedPri
                elseif PT.AbyssSystem.GetDefaultRoomPriority then
                    local defPri = PT.AbyssSystem.GetDefaultRoomPriority(roomKey)
                    if defPri then priority = defPri end
                end
            end

            if priority > bestPriority then
                bestPriority = priority
                bestDoor = door
            end
        end
    end

    -- Fallback: pick first opened door
    if not bestDoor then
        for _, door in ipairs(doorInfos) do
            if door.Opened then return door end
        end
    end

    return bestDoor
end

