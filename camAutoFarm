-- Whitelist picker: WindUI keeps Multi picks in tap order = the whitelist's
-- priority order, shown numbered in the description. AllowNone is required so
-- the last pick can be deselected too (the library default blocks that), which
-- is also what makes off-then-on re-prioritizing possible.
local function noxarWLPriorityText()
    if #talentWhitelist == 0 then
        return "None picked (no priority set)"
    end
    -- one entry per line: a single wrapped line chops mid-name and looks scrambled
    local parts = {}
    for i, c in ipairs(talentWhitelist) do
        parts[i] = tostring(i) .. ". " .. c
    end
    return table.concat(parts, "\n")
end

NoxarElm.TalentWhitelist = AbyssTabW:Dropdown({
    Title = "Whitelist priority",
    Desc = noxarWLPriorityText(),
    Values = NoxarTalentCats,
    Value = talentWhitelist, -- saved array, already in priority order
    Multi = true,
    AllowNone = true,
    Callback = function(Value)
        if noxarCallbackGate() then return end
        talentWhitelist = {}
        for _, name in ipairs(Value) do
            table.insert(talentWhitelist, name)
        end
        NoxarElm.TalentWhitelist:SetDesc(noxarWLPriorityText())
        saveConfig()
    end
})

NoxarElm.TalentBlacklist = AbyssTabW:Dropdown({
    Title = "Blacklist",
    Values = NoxarTalentCats,
    Value = talentBlacklist, -- array of names (WindUI Multi format)
    Multi = true,
    AllowNone = true, -- allow un-blacklisting everything
    Callback = function(Value)
        if noxarCallbackGate() then return end
        local picked = {}
        for _, name in ipairs(Value) do picked[name] = true end
        talentBlacklist = {}
        for _, cat in ipairs(NoxarTalentCats) do
            if picked[cat] then
                table.insert(talentBlacklist, cat)
                -- same as before: blacklisting also removes it from the whitelist
                for i = #talentWhitelist, 1, -1 do
                    if talentWhitelist[i] == cat then
                        table.remove(talentWhitelist, i)
                    end
                end
            end
        end
        -- reflect the trimmed whitelist in the picker (silent; gated)
        syncOption("TalentWhitelist", talentWhitelist)
        NoxarElm.TalentWhitelist:SetDesc(noxarWLPriorityText())
        saveConfig()
    end
})

