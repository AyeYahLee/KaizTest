-- PetSystem (ReplicatedStorage.CommonLogic.Pet.PetSystem) is the game's own
-- pet equip/team manager. Its Client* functions run each channel's local Do
-- step (pet:SetItemEquipedIndex(...) on the client data mirror), which is
-- what makes the pet/team UI refresh LIVE. Invoking the raw remotes via
-- DataPullFunc skips that client Do entirely -- server state changed but
-- the game's UI stayed stale until a rejoin. Always prefer these.
NoxarPetSystemCache = nil
function NoxarGetPetSystem()
    if NoxarPetSystemCache ~= nil then
        return NoxarPetSystemCache
    end

    local pt = _G.PathTool or getPathToolSafe()
    if pt and pt.PetSystem then
        NoxarPetSystemCache = pt.PetSystem
        return NoxarPetSystemCache
    end

    if pt and type(pt.Require) == "function" then
        local ok, mod = pcall(function()
            return pt.Require("PetSystem")
        end)
        if ok and type(mod) == "table" then
            NoxarPetSystemCache = mod
            return mod
        end
    end

    local okDirect, modDirect = pcall(function()
        return NoxarRequireModuleByPath({"CommonLogic", "Pet", "PetSystem"})
    end)
    if okDirect and type(modDirect) == "table" then
        NoxarPetSystemCache = modDirect
        return modDirect
    end

    local module = NoxarFindModuleByName(RS, "PetSystem")
    if module then
        local okSearch, modSearch = pcall(function()
            return require(module)
        end)
        if okSearch and type(modSearch) == "table" then
            NoxarPetSystemCache = modSearch
            return modSearch
        end
    end

    return nil
end

