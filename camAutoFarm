function refreshMonsterList()
    -- Same retry-until-real-names scan the old Scan button / boot task used.
    local types
    for attempt = 1, 6 do
        task.wait(0.3)
        types = scanMonsterTypes()
        local hasRealNames = false
        for _, t in ipairs(types) do
            if not t.displayName:match("^Monster_%d+$") then
                hasRealNames = true
                break
            end
        end
        if hasRealNames or #types == 0 then break end
    end
    local values = { "All Monsters" }
    for _, t in ipairs(types) do
        table.insert(values, t.displayName)
    end
    noxarRefreshDropdown(MonsterDrop, values)
    if selectedMonster then
        -- re-apply the saved choice; Select fires the picker callback like the
        -- old SetValue did (idempotent: writes the same value back)
        MonsterDrop:Select(selectedMonster)
        TargetPara:SetDesc(selectedMonster)
    end
    MonsterDrop:SetDesc("Scan to read the area. Found " .. tostring(#types) .. " types.")
end

