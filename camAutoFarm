-- ==========================================
-- This is the proven animated catch path without the old manual/fallback UI:
-- MonsterCatchStartChannel -> CatchResult -> MonsterCatchUtil.StartCatch(...).
-- No persistent catch loop, Heartbeat connection, or delayed Complete fallback is
-- created here; each call waits until catch really starts, then cleans its
-- temporary state after the 1s process wait.
NoxarAutoCatchCache = NoxarAutoCatchCache or {}
NoxarAutoCatchState = NoxarAutoCatchState or { connections = {}, threads = {} }

function NoxarCleanupAutoCatchState()
    if NoxarAutoCatchState.connections then
        for _, conn in pairs(NoxarAutoCatchState.connections) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(NoxarAutoCatchState.connections)
    end

    if NoxarAutoCatchState.threads then
        for _, thread in pairs(NoxarAutoCatchState.threads) do
            if type(task.cancel) == "function" then pcall(task.cancel, thread) end
        end
        table.clear(NoxarAutoCatchState.threads)
    end

    NoxarAutoCatchState.activeMonsterId = nil
    NoxarAutoCatchState.activeToken = nil
    NoxarAutoCatchState.lastInfo = nil
end

function NoxarEnsurePathToolForCatch()
    if _G.PathTool then return _G.PathTool end
    if PathTool then
        _G.PathTool = PathTool
        return _G.PathTool
    end
    if type(getPathToolSafe) == "function" then
        pcall(function()
            PathTool = getPathToolSafe()
        end)
        if PathTool and not _G.PathTool then
            _G.PathTool = PathTool
        end
    end
    return _G.PathTool or PathTool
end

function NoxarRequireModuleByPath(pathParts)
    local node = RS
    for _, part in ipairs(pathParts) do
        node = node and node:FindFirstChild(part)
    end
    if node and node:IsA("ModuleScript") then
        return require(node)
    end
    return nil
end

function NoxarFindModuleByName(root, moduleName)
    if not root then return nil end
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("ModuleScript") and obj.Name == moduleName then
            return obj
        end
    end
    return nil
end

