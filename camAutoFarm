            BossLoopLiveStatusLbl.TextColor3 = C.red
        end
    end
end

function wasBossDeathNotified(bossName, sinceTime)
    local t = bossName and _G.NoxarBossDeathNotified and _G.NoxarBossDeathNotified[bossName]
    return t ~= nil and (not sinceTime or t >= sinceTime)
end

-- Shared boss-fight attack: fires the game's own
-- ClientAttackMonsterOnHasAlivePet for a monster model (same remote call the
-- farm loop uses). Safe to spam each tick; the game applies real cadence.
function noxarBossAttackMonster(monster)
    local monsterId = monster and (tonumber(monster.Name:match("Monster_(%d+)"))
        or tonumber(monster:GetAttribute("MonsterId")))
    if not monsterId then return end
    pcall(function()
        local PT = _G.PathTool or getPathToolSafe()
        if PT and PT.MonsterSystem and PT.MonsterSystem.ClientAttackMonsterOnHasAlivePet then
            PT.MonsterSystem.ClientAttackMonsterOnHasAlivePet(monsterId)
        end
    end)
end

-- Boss-fight pre-attack gather check (build 26): are ANY of MY OWN equipped
-- pets already close to my character after the snap? Your pets live directly
-- in workspace.Pets as BaseParts carrying PlayerId (owner) and EquipedIndex
-- (equipped slot) attributes -- so PlayerId == my user id AND EquipedIndex
-- set means "my currently equipped pet" and nobody else's pets in that
-- folder can ever count. Distance = pet.Position vs my HumanoidRootPart.
-- Returns (anyWithin, detected): anyWithin = at least one equipped pet of
-- mine sits within radius; detected = how many matched (0 = layout
-- unreadable -- callers must proceed anyway, never hang).
function noxarMyEquippedPetAnyWithin(radius)
    radius = tonumber(radius) or 50
    local root = getRoot()
    local myUid = LP and LP.UserId
    local petsFolder = workspace:FindFirstChild("Pets")
    if not root or not myUid or not petsFolder then return false, 0 end
    local myPos = root.Position

    local detected, anyWithin = 0, false
    for _, pet in ipairs(petsFolder:GetChildren()) do
        if pet:IsA("BasePart")
            and pet:GetAttribute("PlayerId") == myUid
            and pet:GetAttribute("EquipedIndex") ~= nil then
            detected += 1
            if (pet.Position - myPos).Magnitude <= radius then
                anyWithin = true
            end
        end
    end
    return anyWithin, detected
end

-- Mid-fight re-snap failsafe (5s cadence). Build 25: glue-only -- the
-- mount/unmount this used to wrap the snap in is gone on purpose, since the
-- pre-attack gather already settled the pets next to us. Re-finds the live
-- boss model by name (in case the old reference went stale) and NEVER
-- area-teleports.
function resnapToCurrentBoss(bossName, fallbackMonster)
    local monster = findBossByName(bossName) or fallbackMonster
    if not monster then return fallbackMonster end
    local root = monster:FindFirstChild("Root") or monster.PrimaryPart
    if root then
        glueToTarget(root)
    end
    return monster
end

-- Fights a specific boss instance until it dies. Teleports onto it once
-- (same one-shot style as the saved-farm-spot TP button), gathers any of your
-- own equipped pets pulls at least one close (re-mount/unmount cycles),
-- and then attacks at farm cadence via noxarBossAttackMonster (regular
-- bosses; Ultra fights attack from inside their catch-window camp instead)
-- while watching for it to disappear from ClientMonsters -- the game's own
-- pet auto-combat also contributes damage.
-- "Still present in ClientMonsters" is the same death check used everywhere
-- else in this file. A glue-only (no mount/unmount) re-snap runs every 5s as
-- a wander/glitch failsafe. Bails out early (returns false) if
-- bossLoopEnabled goes false mid-fight.
function fightBossUntilDead(monster, isSpecial, bossName)
    local root = monster:FindFirstChild("Root") or monster.PrimaryPart
    if not root then
        local startRootWait = os.clock()
        while os.clock() - startRootWait < 2 do
            root = monster:FindFirstChild("Root") or monster.PrimaryPart
            if root then break end
            task.wait(0.1)
        end
    end

    local fightStartedAt = os.clock()
    local lastSnapAt = fightStartedAt

    if root then
        BossLoopLiveStatusLbl.Text = "Status: Snapping onto " .. tostring(bossName or "boss") .. "..."
        BossLoopLiveStatusLbl.TextColor3 = C.gold

        _G.NoxarSetBossMount(true)
        task.wait(0.1)
        glueToTarget(root)
        task.wait(0.1)
        _G.NoxarSetBossMount(false)
    end

    -- Gather check: the snap teleports US, but our own equipped pets can lag
    -- far behind -- and it only takes ONE of them being close for damage and
    -- your catch eligibility to actually work. So if NONE of MY equipped pets
    -- are within 50 studs, re-mount and unmount again (same NoxarSetBossMount
    -- calls as the snap) to pull them in, then re-check. Capped at 6 cycles
    -- so lost pets can never hang the fight; if we simply cannot locate any
    -- equipped pet nodes, we proceed anyway.
    local gatherCycles = 0
    while bossLoopEnabled and gatherCycles < 6 do
        local anyWithin, detected = noxarMyEquippedPetAnyWithin(50)
        if detected == 0 then break end -- unreadable layout: fight anyway
        if anyWithin then break end -- at least one pet close enough
        gatherCycles += 1
        BossLoopLiveStatusLbl.Text = "Status: Gathering pets (" .. gatherCycles .. "/6)..."
        BossLoopLiveStatusLbl.TextColor3 = C.gold
        _G.NoxarSetBossMount(true)
        task.wait(0.4)
        _G.NoxarSetBossMount(false)
        task.wait(0.2) -- let pulled-in positions settle before measuring again
    end

    BossLoopLiveStatusLbl.Text = "Status: Attacking " .. tostring(bossName or "boss") .. "..."
    BossLoopLiveStatusLbl.TextColor3 = C.gold

    if isSpecial then
        local specialSnapAt = os.clock()
        return NoxarAutoCatchWaitProcessed(
            monster,
            tostring(bossName or "Special"),
            function(text, color)
                BossLoopLiveStatusLbl.Text = text
                BossLoopLiveStatusLbl.TextColor3 = color or C.gold
            end,
            function()
                return bossLoopEnabled
            end,
            function()
                return bossLoopEnabled
            end,
            0,
            1,
            function()
                noxarBossAttackMonster(monster)
                -- 5s glue-only re-snap failsafe (no mount/unmount -- build 25
                -- took those out; the pre-attack gather settled the pets).
                if os.clock() - specialSnapAt >= 5 then
                    specialSnapAt = os.clock()
                    monster = resnapToCurrentBoss(bossName, monster) or monster
                end
            end,
            function()
                -- The catch does not have to come from us: the in-game Auto
                -- battle feature (or another player) may catch the boss while
                -- we camp it. Watch the boss's own ServerNode attributes --
                -- CatchTakenPlayerId lands the INSTANT any catch start is
                -- accepted server-side, long before the model despawns -- plus
                -- the legacy gone/death-notified fallbacks so a stale reader
                -- can never hang the loop.
                local id = noxarMonsterIdFromModel(monster)
                local st = id and noxarReadMonsterCatchState(id) or nil
                if st == "claimed" then
                    return true, "catch claimed"
                end
                if st == "gone" or (st == nil and not clientMonsters:FindFirstChild(monster.Name)) then
                    return true, "boss gone"
                end
                if wasBossDeathNotified(bossName, fightStartedAt) then
                    return true, "boss notified"
                end
                return false
            end,
            function()
                -- Only burn a MonsterCatchStartChannel invoke once the boss's
                -- ServerNode marks US as an eligible catcher (CatchPlayerId_)
                -- -- the same gate the in-game Auto feature applies. If the
                -- reader is unavailable, fall back to the legacy blind
                -- attempt every tick.
                local id = noxarMonsterIdFromModel(monster)
                local st = id and noxarReadMonsterCatchState(id) or nil
                if st == nil then return true end
                return st == "catchable"
            end
        )
    end

    -- Regular bosses: hammer the boss with scripted attacks at farm cadence
    -- (same remote the farm loop and Ultra fights use) on top of the game's
    -- own auto-combat. Death/resnap detection below is intentionally unchanged.
    local lastAttackAt = 0
    while bossLoopEnabled do
        if wasBossDeathNotified(bossName, fightStartedAt) then
            return true -- server kill notification confirmed it
        end

        if not clientMonsters:FindFirstChild(monster.Name) then
            return true -- boss is dead/disappeared from ClientMonsters
        end

        if os.clock() - lastAttackAt >= math.max(ATTACK_DELAY or 0.15, 0.15) then
            lastAttackAt = os.clock()
            noxarBossAttackMonster(monster)
        end

        -- Teleport/glitch failsafe: if we have been "fighting" the same target
        -- for 5s with no MonsterDead notification, snap directly back onto the
        -- live boss model again. Glue-only (no mount/unmount, no area-TP).
        if os.clock() - lastSnapAt >= 5 then
            BossLoopLiveStatusLbl.Text = "Status: Re-snapping to " .. tostring(bossName or "boss") .. "..."
            monster = resnapToCurrentBoss(bossName, monster) or monster
            lastSnapAt = os.clock()
        end

        task.wait(0.1) -- ticks must keep up with attack cadence now
    end

    return false -- got turned off mid-fight
end

-- Runs the full cycle for one queued boss: travel to its area, scan for
-- it by name, teleport onto it, fight until dead.
function runBossFight(entry)
    currentBossFight = entry

    -- Check if this boss was already killed while waiting in the queue
    if wasBossDeathNotified(entry.name) then
        BossLoopLiveStatusLbl.Text = "Status: 💀 " .. entry.name .. " was killed — skipping!"
        BossLoopLiveStatusLbl.TextColor3 = C.red
        task.wait(1)
        currentBossFight = nil
        return
    end

    _G.NoxarSetBossMount(true) -- mount while traveling between boss/special areas
    BossLoopLiveStatusLbl.Text = "Status: " .. entry.name .. " @ " .. entry.area .. " — traveling..."
    BossLoopLiveStatusLbl.TextColor3 = C.gold

    local areaId = AreaFarmIDs[entry.area]
    if not areaId then
        BossLoopLiveStatusLbl.Text = "Status: ❌ Unknown area for " .. entry.name .. " (" .. entry.area .. ")"
        BossLoopLiveStatusLbl.TextColor3 = C.red
        currentBossFight = nil
        return
    end

    pcall(function()
        DataPullFunc:InvokeServer("AreaTeleportToRegionChannel", areaId)
    end)
    task.wait(2)
    if not bossLoopEnabled then currentBossFight = nil; return end

    if wasBossDeathNotified(entry.name) then
        BossLoopLiveStatusLbl.Text = "Status: 💀 " .. entry.name .. " killed during travel — skipping!"
        BossLoopLiveStatusLbl.TextColor3 = C.red
        task.wait(1)
        currentBossFight = nil
        return
    end

    BossLoopLiveStatusLbl.Text = "Status: Waiting for monsters to load in " .. entry.area .. "..."
    local _settled, died = waitForMonstersToSettle(6, entry.name)
    if not bossLoopEnabled or died or wasBossDeathNotified(entry.name) then
        if died or wasBossDeathNotified(entry.name) then
            BossLoopLiveStatusLbl.Text = "Status: 💀 " .. entry.name .. " killed while loading — skipping!"
            BossLoopLiveStatusLbl.TextColor3 = C.red
            task.wait(1)
        end
        currentBossFight = nil
        return
    end

    BossLoopLiveStatusLbl.Text = "Status: Searching for " .. entry.name .. "..."
    local monster = nil
    local searchStartedAt = os.clock()
    local maxFindWait = 15

    while bossLoopEnabled and os.clock() - searchStartedAt < maxFindWait do
        if wasBossDeathNotified(entry.name) then
            BossLoopLiveStatusLbl.Text = "Status: 💀 " .. entry.name .. " killed while searching — skipping!"
            BossLoopLiveStatusLbl.TextColor3 = C.red
            task.wait(1)
            currentBossFight = nil
            return
        end

        monster = findBossByName(entry.name)
        if monster then
            break -- found early, do not wait the rest of the timeout
        end

        local remaining = math.max(0, maxFindWait - (os.clock() - searchStartedAt))
        BossLoopLiveStatusLbl.Text = "Status: Searching for " .. entry.name .. "... " .. string.format("%.0f", remaining) .. "s"
        task.wait(0.25)
    end

    if not bossLoopEnabled then currentBossFight = nil; return end

    if wasBossDeathNotified(entry.name) then
        BossLoopLiveStatusLbl.Text = "Status: 💀 " .. entry.name .. " killed — skipping!"
        BossLoopLiveStatusLbl.TextColor3 = C.red
        task.wait(1)
        currentBossFight = nil
        return
    end

    if not monster then
        BossLoopLiveStatusLbl.Text = "Status: ❌ " .. entry.name .. " not found after 15s search"
        BossLoopLiveStatusLbl.TextColor3 = C.red
        currentBossFight = nil
        return
    end

    local isSpecial = isSpecialBossName(entry.name)
    BossLoopLiveStatusLbl.Text = "Status: Fighting " .. entry.name .. "..."
    BossLoopLiveStatusLbl.TextColor3 = C.gold
    local won = fightBossUntilDead(monster, isSpecial, entry.name)

    if won then
        _G.NoxarSetBossMount(true) -- remount after kill so next travel/return is mounted
        local doneText = isSpecial and "processed" or "defeated"
        BossLoopLiveStatusLbl.Text = "Status: " .. entry.name .. " " .. doneText .. "! Waiting 2s..."
        task.wait(2)
    end

    currentBossFight = nil
end

function isAlreadyTracked(bossName)
    if currentBossFight and currentBossFight.name == bossName then return true end
    for _, q in ipairs(bossQueue) do
        if q.name == bossName then return true end
    end
    return false
end

connectTracked("notificationEvent", NotificationEvent.OnClientEvent, function(...)
    local args = table.pack(...) -- table.pack, not ipairs -- some slots are nil and ipairs would silently stop early

    -- Death notifications use ServerMessage/MonsterDead and include the dead
    -- monster name at args[4][1]. Track them so active fights can end instantly.
    if args[1] == "ServerMessage" and args[2] == "MonsterDead" then
        local payload = args[4]
        if type(payload) == "table" then
            markBossDeathNotified(payload[1])
        end
        return
    end

    if not bossLoopEnabled then return end
    if args[1] ~= "ViewBubble" then return end

    -- Regular bosses use "MonsterAppear"; Ultra Rare monsters use
    -- "UltraRareMonsterAppear". Both payload shapes include Name and
    -- DescParams[2] = area name, so the same queue/fight path can handle both.
    local eventKind = args[2]
    if eventKind ~= "MonsterAppear" and eventKind ~= "UltraRareMonsterAppear" then return end

    local payload = args[4]
    if type(payload) ~= "table" then return end

    local bossName = payload.Name
    local areaName = payload.DescParams and payload.DescParams[2]
    if not bossName or not areaName then return end

    -- Clear stale death notification on a fresh spawn so future fights can queue properly
    if _G.NoxarBossDeathNotified then
        _G.NoxarBossDeathNotified[bossName] = nil
    end

    if not selectedBosses[bossName] then return end -- not one you've opted in to
    if isAlreadyTracked(bossName) then return end

    table.insert(bossQueue, { name = bossName, area = areaName })
    if not currentBossFight then
        BossLoopLiveStatusLbl.Text = "Status: " .. bossName .. " spawned @ " .. areaName .. " — queued (" .. #bossQueue .. ")"
    else
        BossLoopLiveStatusLbl.Text = "Status: Fighting " .. currentBossFight.name .. " — " .. bossName .. " queued next (" .. #bossQueue .. ")"
    end
end)

-- Dispatcher: whenever nothing's currently being fought and the queue has
-- something waiting, pop the next one (FIFO) and run it -- never
-- interrupting whatever fight is already in progress. When the queue
-- drains completely, return to the farming spot and cleanly resume the
-- regular Auto-Farm loop if it was on before the boss loop took over.
spawnTracked("bossLoop", function()
    local returnedToFarmSpot = true -- starts true so it doesn't try to "return" before ever leaving
    while task.wait(0.5) do
        if not bossLoopEnabled then
            returnedToFarmSpot = true
            continue
        end

        if not currentBossFight and #bossQueue > 0 then
            returnedToFarmSpot = false
            if running then
                wasFarmingBeforeBossFight = true
                toggleFarming(false) -- cleanly stop Auto-Farm (updates its button too), not just flipping `running`
            end
            -- (no else-clear for the flag: if an earlier cycle's resume got
            -- interrupted by a fresh spawn, the intent must survive into
            -- the next drain instead of being silently dropped)

            local nextEntry = table.remove(bossQueue, 1)
            runBossFight(nextEntry)

        elseif not currentBossFight and #bossQueue == 0 and not returnedToFarmSpot then
            if farmingSpot then
                BossLoopLiveStatusLbl.Text = "Status: Queue empty — returning to Farming Spot..."
                BossLoopLiveStatusLbl.TextColor3 = Color3.fromRGB(205, 215, 245)
                -- Teleport/travel back to saved Farming Spot (stays mounted during travel)
                teleportToAreaFarmSpot(farmingSpot, true, 5)
            end
            _G.NoxarSetBossMount(false, true) -- Unmount AFTER travel/teleport back to Farming Spot completes
            if wasFarmingBeforeBossFight then
                -- Settle before handing control back to Auto-Farm: the area
                -- and character need a moment to finish streaming in. Bails
                -- early (keeping the resume intent) if a fresh boss queues
                -- up or the loop gets toggled off mid-countdown.
                for settleSec = 4, 1, -1 do
                    if not bossLoopEnabled or #bossQueue > 0 then break end
                    BossLoopLiveStatusLbl.Text = "Status: Back at spot — resuming Auto-Farm in " .. settleSec .. "s..."
                    BossLoopLiveStatusLbl.TextColor3 = Color3.fromRGB(205, 215, 245)
                    task.wait(1)
                end
                if bossLoopEnabled and #bossQueue == 0 then
                    if not running then
                        toggleFarming(true) -- cleanly restart Auto-Farm (spawns a fresh farmLoop thread, updates its button)
                    end
                    wasFarmingBeforeBossFight = false
                end
            end
            BossLoopLiveStatusLbl.Text = "Status: Waiting for a boss spawn..."
            BossLoopLiveStatusLbl.TextColor3 = Color3.fromRGB(205, 215, 245)
            returnedToFarmSpot = true
        end
    end
end)


