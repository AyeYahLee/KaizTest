function toggleFarming(forceState)
    -- Same behavior as the old Start Farm button handler. syncOption keeps
    -- the WindUI toggle honest when the boss loop pauses/resumes farming.
    if forceState ~= nil then
        running = forceState
    else
        running = not running
    end

    syncOption("FarmToggle", running)
    saveConfig()

    if running then
        runId += 1
        spawnTracked("farmLoop", function() startFarming(FarmStatus) end)
    else
        unlockTarget()
        -- hard-stop the loop thread now; the flag alone let a dead thread
        -- linger in the registry until the next start/boot cleaned it up
        cancelTracked("farmLoop")
        -- bump runId so nothing the just-stopped loop still does (its
        -- exit-path status write, a tick swallowed by a pcall'd yield) can
        -- count as the active run or overwrite the Disabled status
        runId += 1
        FarmStatus.Text = "Status: Disabled"
        -- one-shot re-assert after in-flight writes settle (no-op if the
        -- user re-enabled the farm in the meantime)
        task.delay(0.15, function()
            if not running then
                FarmStatus.Text = "Status: Disabled"
            end
        end)
    end
end

