local function getHumanoid()
    local char = LP.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- Walk the character to a position using Humanoid:MoveTo (real walking,
-- visible to other players). Returns true if arrived within threshold.
local function walkToPosition(targetPos, threshold, maxTime, stillRunningFn)
    threshold = threshold or 8
    maxTime = maxTime or 30

    local root = getRoot()
    if not root then return false end

    local hum = getHumanoid()
    if not hum then return false end

    hum:MoveTo(targetPos)

    local startTick = os.clock()
    local lastReissue = 0
    while stillRunningFn and stillRunningFn() do
        root = getRoot()
        if not root then return false end

        local pos = root.Position
        local dx = targetPos.X - pos.X
        local dz = targetPos.Z - pos.Z
        local dist = math.sqrt(dx * dx + dz * dz)

        if dist <= threshold then
            return true
        end

        -- Re-issue MoveTo if humanoid stopped moving
        local now = os.clock()
        if now - lastReissue >= 1.5 then
            local h = getHumanoid()
            if h then h:MoveTo(targetPos) end
            lastReissue = now
        end

        if now - startTick >= maxTime then
            root.CFrame = CFrame.new(targetPos.X, targetPos.Y + 3, targetPos.Z)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            return true
        end

        task.wait(0.15)
    end
    return false
end

-- Walk to a door and click it
-- In legit mode: walk to the door, then click it
local function walkToDoorAndClick(door)
    if not door or not door.CFrame then return false end

    local root = getRoot()
    if not root then return false end

    local doorPos = door.CFrame.Position

    if legitModeEnabled then
        -- Walk toward the door on the CURRENT floor level — MoveTo can't
        -- pathfind to the door's own Y if it's elevated/in a wall.
        -- Once we're close enough in XZ, the ClickDetector (15 studs) fires.
        AbyssStatusLbl.Text = "🚶 Walking to door..."
        AbyssStatusLbl.TextColor3 = C.gold
        local myRoot = getRoot()
        local walkTarget = myRoot
            and Vector3.new(doorPos.X, myRoot.Position.Y, doorPos.Z)
            or doorPos
        walkToPosition(walkTarget, 15, 20, function() return autoAbyssEnabled or legitModeEnabled end)
        AbyssStatusLbl.Text = "🚪 Clicking door..."
        task.wait(0.5)
    else
        root.CFrame = CFrame.new(doorPos.X, doorPos.Y + 3, doorPos.Z)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    task.wait(0.3)

    -- Find and click the door model in AbyssClientModel
    local clicked = false
    local abyssModelFolder = workspace:FindFirstChild("AbyssClientModel")
    if abyssModelFolder then
        for _, model in ipairs(abyssModelFolder:GetChildren()) do
            if clicked then break end
            local pp = model.PrimaryPart or model:FindFirstChild("Root")
            if pp and (pp.Position - doorPos).Magnitude < 15 then
                local cd = pp:FindFirstChildOfClass("ClickDetector")
                if cd then
                    pcall(function() fireclickdetector(cd) end)
                    clicked = true
                else
                    -- Try clicking via the model itself
                    for _, desc in ipairs(model:GetDescendants()) do
                        if desc:IsA("ClickDetector") then
                            pcall(function() fireclickdetector(desc) end)
                            clicked = true
                            break
                        end
                    end
                end
            end
        end
    end

    -- Fallback: try clicking any ClickDetector near the door position
    if not clicked then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ClickDetector") and obj.Parent and obj.Parent:IsA("BasePart") then
                if (obj.Parent.Position - doorPos).Magnitude < 10 then
                    pcall(function() fireclickdetector(obj) end)
                    clicked = true
                    break
                end
            end
        end
    end

    return clicked
end

-- Auto-select talent when available
local function tryAutoSelectTalent(syncKey)
    local talentInfo = getAbyssSyncValue(syncKey, {"TalentInfo"})
    if not talentInfo or not talentInfo.Seed then return false end

    local PT = _G.PathTool or getPathToolSafe()
    if not PT or not PT.AbyssSystem then return false end

    local abyssId = getAbyssSyncValue(syncKey, {"AbyssId"})
    if not abyssId then return false end

    local playerSelect = talentInfo.PlayerSelect
    if playerSelect and playerSelect[tostring(LP.UserId)] then
        return false
    end

    -- Auto-reset pick history on new Abyss run or replay
    -- Detect: new sync key = different Abyss, OR RestartInfo disappeared = replay
    local restartInfoNow = getAbyssSyncValue(syncKey, {"RestartInfo"})
    if syncKey ~= talentLastAbyssKey then
        talentLastAbyssKey = syncKey
        talentPickHistory = {}
        talentSawRestartInfo = false
    elseif talentSawRestartInfo and not restartInfoNow then
        -- RestartInfo was present (win screen) then disappeared (replay processing)
        talentPickHistory = {}
        talentSawRestartInfo = false
    end
    if restartInfoNow then
        talentSawRestartInfo = true
    end

    local ok, talents = pcall(function()
        return PT.AbyssSystem.GenerateSelectableTalents(talentInfo.Seed, getGamePlayer(), abyssId)
    end)
    if not ok or not talents or #talents == 0 then return false end

    local bestIdx = nil
    local bestScore = -math.huge

    -- Two-pass scoring: first with all restrictions, then fallback ignoring max copies
    -- Blacklist is NEVER ignored
    for pass = 1, 2 do
        for i, talent in ipairs(talents) do
            local tmpl = talent.TalentTmpl
            local name = tmpl and tmpl.Name or ""
            local cat = getTalentCategory(name)

            if not isTalentBlacklisted(name) then
                local maxCopies = talentMaxCopies[cat] or 99
                local currentCopies = talentPickHistory[cat] or 0
                -- Pass 1: respect max copies. Pass 2: ignore max copies.
                if pass == 2 or currentCopies < maxCopies then
                    local q = tmpl and tmpl.Quality or 0
                    local qNum = type(q) == "number" and q or (tonumber(q) or 0)
                    local v = (tmpl and tmpl.PlayerProperty and tmpl.PlayerProperty.Value) or 0
                    local wlRank = getWhitelistRank(name)

                    local score = 0
                    if wlRank <= #talentWhitelist then
                        score = 10000 + (qNum * 100) + (v * 10) - wlRank
                    else
                        score = (qNum * 100) + (v * 10)
                    end
                    -- Pass 2 (fallback) gets a penalty so it only wins if pass 1 found nothing
                    if pass == 2 then score = score - 100000 end

                    if score > bestScore then
                        bestScore = score
                        bestIdx = i
                    end
                end
            end
        end
        if bestIdx then break end -- found a valid talent, no need for fallback
    end

    if not bestIdx then return false end

    local chosenTalent = talents[bestIdx]
    local chosenName = chosenTalent.TalentTmpl and chosenTalent.TalentTmpl.Name or ""
    local chosenCat = getTalentCategory(chosenName)
    talentPickHistory[chosenCat] = (talentPickHistory[chosenCat] or 0) + 1

    local selectOk = pcall(function()
        PT.AbyssSystem.ClientSelectTalent(bestIdx)
    end)
    return selectOk
end

-- Main Auto Abyss loop

-- Find and teleport to the talent selection model in AbyssClientModel.
-- The talent model has a "jitan2" subchild (doors have "haomen").
function teleportToTalentModel()
    local root = getRoot()
    if not root then return false end

    local abyssFolder = workspace:FindFirstChild("AbyssClientModel")
    if not abyssFolder then return false end

    for _, child in ipairs(abyssFolder:GetChildren()) do
        local jitan = child:FindFirstChild("jitan2", true)
        if jitan then
            local rootPart = child:FindFirstChild("Root", true) or child:FindFirstChildWhichIsA("BasePart", true)
            if rootPart then
                root.CFrame = rootPart.CFrame + Vector3.new(0, 3, 0)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                return true
            end
        end
    end
    return false
end

-- Legit-mode-aware talent model movement: walks to the talent model
-- then selects the talent.
-- Takes the loop's stillRunning check as a parameter.
local function goToTalentModel(stillRunningFn)
    if not legitModeEnabled then
        return teleportToTalentModel()
    end

    local abyssFolder = workspace:FindFirstChild("AbyssClientModel")
    if not abyssFolder then return false end

    for _, child in ipairs(abyssFolder:GetChildren()) do
        local jitan = child:FindFirstChild("jitan2", true)
        if jitan then
            local rootPart = child:FindFirstChild("Root", true) or child:FindFirstChildWhichIsA("BasePart", true)
            if rootPart then
                -- Walk to talent model — same spot teleport uses
                local walkTarget = rootPart.Position + Vector3.new(0, 3, 0)
                walkToPosition(walkTarget, 8, 20, stillRunningFn)
                task.wait(0.3)
                return true
            end
        end
    end
    return false
end

-- Finds the closest room in SpaceModels to the player right now.
-- Returns (centerCFrame, distance) or (nil, nil) if nothing found.
-- Shared by both the initial floor-change centering and the periodic
-- drift-check below, so there's one copy of this logic instead of two.
local function getClosestRoomCenter()
    local root = getRoot()
    if not root then return nil, nil end

    local closestRoom = nil
    local closestDist = math.huge
    local spaceModels = workspace:FindFirstChild("SpaceModels")
    if spaceModels then
        for _, room in ipairs(spaceModels:GetChildren()) do
            local roomRoot = room:FindFirstChild("Root")
            if roomRoot then
                local dist = (root.Position - roomRoot.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestRoom = room
                end
            end
        end
    end

    if closestRoom and closestRoom:FindFirstChild("Root") then
        return closestRoom.Root.CFrame, closestDist
    end
    return nil, nil
end

function autoAbyssLoop(myGen)
    local function stillRunning()
        return (autoAbyssEnabled or legitModeEnabled) and myGen == _G.NoxarAbyssLoopGeneration
    end

    local lastStage = nil -- track floor changes for auto-center teleport
    local lastChosenRoomType = nil -- track if last door was Rest (type 4) for fast-forward

    while stillRunning() do
        -- Phase 1: Check if we're in an Abyss
        local inAbyss, _ = isInAbyssArea()
        local syncKey = getAbyssSyncKey()

        if inAbyss and syncKey then
            -- We're in an Abyss — monitor and act
            AbyssStatusLbl.Text = "⚔ In Abyss — monitoring floor..."
            AbyssStatusLbl.TextColor3 = C.gold

            local stage = getAbyssSyncValue(syncKey, {"Stage"})
            local doorInfos = getAbyssSyncValue(syncKey, {"DoorInfos"})
            local restartInfo = getAbyssSyncValue(syncKey, {"RestartInfo"})

            -- Auto-center: when floor changes, teleport to room center
            -- Skip for Rest rooms (type 4) — no combat, just talent + next door
            if stage and stage ~= lastStage then
                lastStage = stage

                if lastChosenRoomType == 4 then
                    -- Rest room: if talent exists, teleport to it and select, then pick next door
                    AbyssStatusLbl.Text = "Rest room..."
                    AbyssStatusLbl.TextColor3 = C.accent

                    -- Check if this Rest room has a talent selection
                    local restTalentInfo = getAbyssSyncValue(syncKey, {"TalentInfo"})
                    if restTalentInfo and restTalentInfo.Seed then
                        local restPlayerSelect = restTalentInfo.PlayerSelect
                        local restAlreadySelected = restPlayerSelect and restPlayerSelect[tostring(LP.UserId)]
                        if not restAlreadySelected and autoSelectTalent then
                            -- Talent exists and not yet selected - go to it
                            AbyssStatusLbl.Text = "Rest room - selecting talent..."
                            goToTalentModel(stillRunning)
                            task.wait(0.5)
                            tryAutoSelectTalent(syncKey)
                            task.wait(0.3)

                            -- Retry once if still not selected
                            local rt2 = getAbyssSyncValue(syncKey, {"TalentInfo"})
                            local rp2 = rt2 and rt2.PlayerSelect
                            if rt2 and rt2.Seed and (not rp2 or not rp2[tostring(LP.UserId)]) then
                                tryAutoSelectTalent(syncKey)
                                task.wait(0.3)
                            end
                        end
                    end

                    -- Now pick next door
                    AbyssStatusLbl.Text = "Rest room - picking next door..."
                    local restDoors = getAbyssSyncValue(syncKey, {"DoorInfos"})
                    if restDoors and #restDoors > 0 then
                        local nextDoor = pickPreferredDoor(restDoors)
                        if nextDoor then
                            -- Update lastChosenRoomType to the NEW door's type
                            local pt4 = _G.PathTool or getPathToolSafe()
                            local mt4 = pt4 and pt4.CfgAbyss and pt4.CfgAbyss.RoomTmpls
                            if mt4 and mt4[nextDoor.RoomId] then
                                lastChosenRoomType = mt4[nextDoor.RoomId].RoomType
                            else
                                lastChosenRoomType = nil
                            end

                            walkToDoorAndClick(nextDoor)
                            task.wait(1.5)
                            continue
                        end
                    end

                    -- No doors yet, brief wait then continue to normal flow
                    task.wait(0.5)
                else
                    -- Normal room: center and prepare for combat
                    AbyssStatusLbl.Text = "📍 Floor " .. tostring(stage) .. " — centering..."
                    AbyssStatusLbl.TextColor3 = C.accent

                    local root = getRoot()
                    local centerCFrame, centerDist = getClosestRoomCenter()
                    if root and centerCFrame then
                        if legitModeEnabled and centerDist and centerDist > 8 then
                            -- Legit mode: walk to center
                            AbyssStatusLbl.Text = "🚶 Floor " .. tostring(stage) .. " — walking to center..."
                            walkToPosition(centerCFrame.Position, 8, 20, stillRunning)
                        else
                            root.CFrame = centerCFrame + Vector3.new(0, 3, 0)
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                    task.wait(0.5) -- brief settle after teleport/walk
                end

                lastChosenRoomType = nil -- reset after processing
            end

            -- Check for win screen — handle restart directly (self-contained, no separate toggle)
            if restartInfo then
                AbyssStatusLbl.Text = "🏆 Abyss complete! Restarting..."
                AbyssStatusLbl.TextColor3 = C.green

                -- Wait for restart to become available (PlayerId == 0)
                local restartAttempts = 0
                while stillRunning() and restartAttempts < 20 do
                    local ri = getAbyssSyncValue(syncKey, {"RestartInfo"})
                    if ri and ri.PlayerId == 0 then
                        pcall(function()
                            local rpt = _G.PathTool or getPathToolSafe()
                            if rpt and rpt.AbyssSystem and rpt.AbyssSystem.ClientRestartAbyss then
                                rpt.AbyssSystem.ClientRestartAbyss()
                            end
                        end)
                        AbyssStatusLbl.Text = "🏆 Replay sent!"
                        break
                    elseif not ri then
                        break
                    end
                    restartAttempts = restartAttempts + 1
                    task.wait(0.5)
                end

                -- Wait for restart to process (RestartInfo disappears then reappears next win)
                local waitCount = 0
                while stillRunning() and waitCount < 20 do
                    local ri2 = getAbyssSyncValue(syncKey, {"RestartInfo"})
                    if not ri2 then break end
                    waitCount = waitCount + 1
                    task.wait(0.5)
                end

                lastStage = nil -- reset so next entry triggers centering
                lastChosenRoomType = nil
                task.wait(1)
                continue
            end

                        -- Check for talent selection (with jitan2 teleport safety)
            local talentInfo = getAbyssSyncValue(syncKey, {"TalentInfo"})
            if talentInfo and talentInfo.Seed then
                local playerSelect = talentInfo.PlayerSelect
                local alreadySelected = playerSelect and playerSelect[tostring(LP.UserId)]
                if not alreadySelected and autoSelectTalent then
                    AbyssStatusLbl.Text = "Selecting talent..."
                    AbyssStatusLbl.TextColor3 = C.accent
                    local talentStartTime = os.clock()

                    -- Try selecting talent
                    tryAutoSelectTalent(syncKey)
                    task.wait(0.3)

                    -- Check if still not selected after 1s
                    local ti2 = getAbyssSyncValue(syncKey, {"TalentInfo"})
                    local ps2 = ti2 and ti2.PlayerSelect
                    local stillPending = ti2 and ti2.Seed and (not ps2 or not ps2[tostring(LP.UserId)])

                    if stillPending and os.clock() - talentStartTime < 3 then
                        -- Still pending - go to talent model (jitan2) to get in range
                        AbyssStatusLbl.Text = legitModeEnabled and "Talent: walking to model..." or "Talent: teleporting to model..."
                        AbyssStatusLbl.TextColor3 = C.gold
                        goToTalentModel(stillRunning)
                        task.wait(0.3)
                        tryAutoSelectTalent(syncKey)
                        task.wait(0.3)
                    end

                    -- If STILL not selected after 3+ seconds, give up and move on
                    local ti3 = getAbyssSyncValue(syncKey, {"TalentInfo"})
                    local ps3 = ti3 and ti3.PlayerSelect
                    local finalCheck = ti3 and ti3.Seed and (not ps3 or not ps3[tostring(LP.UserId)])
                    if finalCheck then
                        AbyssStatusLbl.Text = "Talent: skipping (timed out)"
                        AbyssStatusLbl.TextColor3 = C.red
                        task.wait(0.5)
                    end

                    -- Re-fetch doors and fall through to door check below
                    doorInfos = getAbyssSyncValue(syncKey, {"DoorInfos"})
                end
            end
            -- Always re-fetch doors right before checking them
            doorInfos = getAbyssSyncValue(syncKey, {"DoorInfos"})
            -- Check for door selection
            if doorInfos and #doorInfos > 0 then
                local door = pickPreferredDoor(doorInfos)
                if door then
                    -- Show the room type name in status
                    local roomTypeName = "Unknown"
                    local PT2 = _G.PathTool or getPathToolSafe()
                    local roomTmpls2 = PT2 and PT2.CfgAbyss and PT2.CfgAbyss.RoomTmpls
                    if roomTmpls2 and roomTmpls2[door.RoomId] then
                        local rt = roomTmpls2[door.RoomId].RoomType
                        roomTypeName = ROOM_TYPE_NAMES[rt] or ("Type " .. tostring(rt))
                    end

                    AbyssStatusLbl.Text = "🚪 Floor " .. tostring(stage or "?") .. " — choosing " .. roomTypeName .. " room..."
                    AbyssStatusLbl.TextColor3 = C.accent

                    -- Track room type for Rest room fast-forward
                    local PT3 = _G.PathTool or getPathToolSafe()
                    local roomTmpls3 = PT3 and PT3.CfgAbyss and PT3.CfgAbyss.RoomTmpls
                    if roomTmpls3 and roomTmpls3[door.RoomId] then
                        lastChosenRoomType = roomTmpls3[door.RoomId].RoomType
                    end

                    walkToDoorAndClick(door)
                    task.wait(2) -- wait for room transition
                    continue
                end
            end

            -- No doors, no talent, no win — we're fighting. Just wait.
            AbyssStatusLbl.Text = "⚔ Floor " .. tostring(stage or "?") .. " — fighting..."
            AbyssStatusLbl.TextColor3 = C.gold

            -- Check boss bar for fight state
            local _, bossBarVisible = getRiftBossBarState()
            if bossBarVisible then
                -- Boss fight in progress — wait for it to end
                AbyssStatusLbl.Text = "⚔ Floor " .. tostring(stage or "?") .. " — boss fight..."
                AbyssStatusLbl.TextColor3 = C.gold
                while stillRunning() do
                    local _, stillVisible = getRiftBossBarState()
                    if not stillVisible then break end
                    task.wait(0.5)
                end
                task.wait(1)
                continue
            end

            -- No boss bar, check if monsters exist
            -- Drift check: sometimes floor spawn lands you away from the
            -- actual room center (rare, but happens). Only re-center here
            -- -- while genuinely fighting, not during doors/talent/rest/
            -- restart/boss-fights -- and only if actually far away, so
            -- this doesn't fight against normal in-combat movement.
            local ABYSS_DRIFT_THRESHOLD = 20
            local driftCenter, driftDist = getClosestRoomCenter()
            if driftCenter and driftDist and driftDist > ABYSS_DRIFT_THRESHOLD then
                local driftRoot = getRoot()
                if driftRoot then
                    AbyssStatusLbl.Text = "📍 Floor " .. tostring(stage or "?") .. " — re-centering (drifted)..."
                    AbyssStatusLbl.TextColor3 = C.accent
                    if legitModeEnabled then
                        walkToPosition(driftCenter.Position, 8, 15, stillRunning)
                    else
                        driftRoot.CFrame = driftCenter + Vector3.new(0, 3, 0)
                        driftRoot.AssemblyLinearVelocity = Vector3.zero
                        driftRoot.AssemblyAngularVelocity = Vector3.zero
                    end
                    task.wait(0.3)
                end
            end

            if #clientMonsters:GetChildren() > 0 then
                -- Auto-attack: call the game's attack function on every alive monster
                for _, m in ipairs(clientMonsters:GetChildren()) do
                    local monsterId = tonumber(m.Name:match("Monster_(%d+)"))
                        or tonumber(m:GetAttribute("MonsterId"))
                    if monsterId then
                        pcall(function()
                            local PT = _G.PathTool or getPathToolSafe()
                            if PT and PT.MonsterSystem and PT.MonsterSystem.ClientAttackMonsterOnHasAlivePet then
                                PT.MonsterSystem.ClientAttackMonsterOnHasAlivePet(monsterId)
                            end
                        end)
                    end
                end
            end

            task.wait(0.5)

        else
            -- Not in an Abyss
            lastStage = nil
            lastChosenRoomType = nil

            -- Legit Mode: only operates inside an Abyss (no portal/team/start handling)
            if legitModeEnabled then
                AbyssStatusLbl.Text = "⏸ Legit Mode: waiting — enter an Abyss first..."
                AbyssStatusLbl.TextColor3 = C.sub
                task.wait(2)
                continue
            end

            -- Step 1: Teleport to Abyss entrance
            AbyssStatusLbl.Text = "Teleporting to Abyss entrance..."
            AbyssStatusLbl.TextColor3 = C.gold

            local root = getRoot()
            if not root then
                task.wait(1)
                continue
            end

            local abyssEntrance = nil
            pcall(function()
                abyssEntrance = workspace
                    :WaitForChild("Area", 5)
                    :WaitForChild("center", 5)
                    :WaitForChild("Area", 5)
                    :WaitForChild("Abyss", 5)
                    :WaitForChild("Abyss_1", 5)
            end)

            if not abyssEntrance then
                AbyssStatusLbl.Text = "Abyss entrance not found - retrying..."
                AbyssStatusLbl.TextColor3 = C.red
                task.wait(3)
                continue
            end

            -- Find the target part to teleport to
            local targetPart = nil
            if abyssEntrance:IsA("BasePart") then
                targetPart = abyssEntrance
            elseif abyssEntrance.PrimaryPart then
                targetPart = abyssEntrance.PrimaryPart
            else
                targetPart = abyssEntrance:FindFirstChildWhichIsA("BasePart", true)
            end

            if not targetPart then
                AbyssStatusLbl.Text = "No teleportable part at Abyss entrance"
                AbyssStatusLbl.TextColor3 = C.red
                task.wait(3)
                continue
            end

            -- Teleport
            root.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            task.wait(2) -- wait for area to stream in

            -- Step 2: Verify we're near the entrance
            root = getRoot()
            if root and targetPart and targetPart.Parent then
                local dist = (root.Position - targetPart.Position).Magnitude
                if dist > 50 then
                    root.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                    task.wait(1.5)
                end
            end

            if not stillRunning() then break end

            -- Step 3: Cancel any previous preparation
            AbyssStatusLbl.Text = "Preparing team..."
            AbyssStatusLbl.TextColor3 = C.sub
            pcall(function()
                DataPullFunc:InvokeServer("AbyssTeamCreatePrepareCancelChannel", 1)
            end)
            task.wait(0.5)

            -- Step 4: Prepare team
            pcall(function()
                DataPullFunc:InvokeServer("AbyssTeamCreatePrepareChannel", 1)
            end)
            task.wait(0.5)

            if not stillRunning() then break end

            -- Step 5: Create team (showId=1, abyssTmplId, playerCount=4)
            -- Using playerCount=4 to match the max PlayerAmountLimit
            AbyssStatusLbl.Text = "Creating team..."
            AbyssStatusLbl.TextColor3 = C.gold
            local createOk = false
            pcall(function()
                DataPullFunc:InvokeServer("AbyssCreateTeamChannel", 1, selectedAbyssTmplId, 4)
                createOk = true
            end)
            task.wait(0.5)

            if not stillRunning() then break end

            -- Step 6: Start Abyss
            if createOk then
                AbyssStatusLbl.Text = "Starting Abyss..."
                AbyssStatusLbl.TextColor3 = C.green
                pcall(function()
                    DataPullFunc:InvokeServer("AbyssStartChannel")
                end)
                task.wait(2)
            else
                AbyssStatusLbl.Text = "Team creation failed - retrying in 5s..."
                AbyssStatusLbl.TextColor3 = C.red
                task.wait(5)
            end
        end

        task.wait(0.5)
    end

    if myGen == _G.NoxarAbyssLoopGeneration then
        AbyssStatusLbl.Text = "⏹ Stopped."
        AbyssStatusLbl.TextColor3 = C.sub
    end
end

function startAutoAbyss()
    _G.NoxarAbyssLoopGeneration = (_G.NoxarAbyssLoopGeneration or 0) + 1
    local gen = _G.NoxarAbyssLoopGeneration
    spawnTracked("autoAbyssLoop", function()
        autoAbyssLoop(gen)
    end)
end

function stopAutoAbyss()
    _G.NoxarAbyssLoopGeneration = (_G.NoxarAbyssLoopGeneration or 0) + 1
    cancelTracked("autoAbyssLoop")
end


