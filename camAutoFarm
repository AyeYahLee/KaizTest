-- lockOntoTarget was removed in the Auto Farm rework: the new farm loop
-- snaps onto each target once via glueToTarget and fights through the
-- monster-id attack call, so a per-frame CFrame re-lock connection is no
-- longer needed anywhere.

-- glueToTarget: teleports the player on top of the target once (a
-- "snap TP"), instead of holding a persistent connection. This is used
-- only by the boss fight (fightBossUntilDead), which snaps once when
-- the fight starts and then relies on your in-game auto-attack -- it
-- doesn't need continuous re-locking the way regular farming does.
function glueToTarget(targetRoot)
    if not targetRoot or not targetRoot.Parent then return end
    local r = getRoot()
    if not r then return end

    local pos = targetRoot.Position
    local _, monsterYRotation, _ = targetRoot.CFrame:ToOrientation()

    groundRayParams.FilterDescendantsInstances = {
        LP.Character,
        targetRoot.Parent,
        clientMonsters
    }

    local rayOrigin = Vector3.new(pos.X, pos.Y + 5, pos.Z)
    local raycastResult = workspace:Raycast(rayOrigin, rayDirection, groundRayParams)
    local groundY = raycastResult and raycastResult.Position.Y or (pos.Y - 4)

    r.CFrame = CFrame.new(pos.X, groundY + HOVER_HEIGHT, pos.Z) * CFrame.fromOrientation(0, monsterYRotation, 0)
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero
end

function buildNameCache()
    table.clear(nameCache) 
    if not clientMonsters then return end

    local selfGui = workspace:FindFirstChild("SelfGUI")
    if not selfGui then return end

    for _, gui in ipairs(selfGui:GetChildren()) do
        if not gui:IsA("BillboardGui") then continue end
        local adornee = gui.Adornee
        if not adornee then continue end
        local candidates = { adornee.Parent and adornee.Parent.Parent, adornee.Parent }
        for _, monster in ipairs(candidates) do
            if monster and monster.Parent == clientMonsters then
                local labName = gui:FindFirstChild("LabName", true)
                local labLv = gui:FindFirstChild("LabLv", true)
                if labName and labName:IsA("TextLabel") and labName.Text ~= "" then
                    nameCache[monster.Name] = { name = labName.Text, level = labLv and labLv.Text or "" }
                end
                break
            end
        end
    end
end

function scanMonsterTypes()
    buildNameCache()
    local seen = {}
    local types = {}

    for _, m in ipairs(clientMonsters:GetChildren()) do
        local info = nameCache[m.Name]
        local displayName = info and info.name or m.Name
        local root = m:FindFirstChild("Root")
        local pos = root and root:IsA("BasePart") and root.Position or (m.PrimaryPart and m.PrimaryPart.Position)
        
        if not seen[displayName] then
            seen[displayName] = true
            table.insert(types, {displayName = displayName, level = info and info.level or "", count = 1, pos = pos})
        else
            for _, t in ipairs(types) do
                if t.displayName == displayName then t.count += 1; break end
            end
        end
    end
    table.sort(types, function(a,b) return a.displayName < b.displayName end)
    return types
end

function getTargetMonsters()
    local monsters = {}
    for _, m in ipairs(clientMonsters:GetChildren()) do
        local info = nameCache[m.Name]
        local displayName = info and info.name or m.Name
        if selectedMonster and not displayName:lower():find(selectedMonster:lower(), 1, true) then
            continue
        end
        local root = m:FindFirstChild("Root")
        local pos = root and root:IsA("BasePart") and root.Position or (m.PrimaryPart and m.PrimaryPart.Position)
        if pos then table.insert(monsters, {model = m, pos = pos, root = root}) end
    end
    return monsters
end

-- AUTO FARM (reworked cycle):
-- Attack/targeting side: TP mode teleports onto the current target
-- (one-shot snap, boss-style), then immediately unequips+re-equips pets so
-- they re-spawn ON the new target instead of walking over from the old spot
-- (TP mode ONLY -- Stay in Spot never equips/unequips), and auto-attacks
-- ONLY that target (Auto-Abyss style, by monster id).
-- Catch side: an INDEPENDENT V6-tester-style sweep runs every 0.15s fight
-- tick -- it reads the visible catch prompt + the game's can-catch list and
-- instantly catches EVERY catchable FILTERED monster within
-- NEARBY_CATCH_RADIUS of the player (MonsterCatchStartChannel -> CatchResult
-- -> MonsterCatchUtil.StartCatch, no waits), including stacked same-spot
-- spawns and the current target itself. The sweep NEVER teleports to a
-- catchable monster; catching runs from wherever the player is standing.
-- Auto Catch OFF = classic mode: attack the current target until it dies.
-- "Stay in Spot" mode: no teleports, no equip/unequip -- hold an anchor
-- position and fight any alive, filter-matching monster within SPOT_RADIUS.
-- Scanning/filtering (getTargetMonsters) is intentionally unchanged.
function startFarming(statusLbl)
    local myId = runId
    local completed = 0
    local completedTargets = {} -- model.Name -> true (caught this run)
    local catchCooldowns = {}   -- monsterId -> next allowed catch attempt (V6-style lockout)

    local function farmActive()
        return running and runId == myId
    end

    -- Same attack call the Auto Abyss loop uses, restricted to exactly one
    -- monster id so no nearby/random entity is ever engaged.
    local function attackMonster(model)
        local monsterId = model and (tonumber(model.Name:match("Monster_(%d+)"))
            or tonumber(model:GetAttribute("MonsterId")))
        if not monsterId then return end
        pcall(function()
            local PT = _G.PathTool or getPathToolSafe()
            if PT and PT.MonsterSystem and PT.MonsterSystem.ClientAttackMonsterOnHasAlivePet then
                PT.MonsterSystem.ClientAttackMonsterOnHasAlivePet(monsterId)
            end
        end)
    end

    -- Cancellable wait; returns false if the farm stopped/got superseded.
    local function waitChecked(seconds)
        local untilAt = os.clock() + seconds
        while os.clock() < untilAt do
            if not farmActive() then return false end
            task.wait(math.min(0.1, math.max(0, untilAt - os.clock())))
        end
        return true
    end

    -- Fights one target until it's caught or dead (either way), or it strays
    -- out of reach (Stay mode). Catching is done by an INDEPENDENT fast
    -- sweep (V6-tester style): every 0.15s tick it instantly catches EVERY
    -- nearby catchable filtered monster -- stacked same-spot spawns,
    -- wanderers AND the current target -- from wherever the player stands.
    -- The sweep never teleports; teleporting is the targeting system's job.
    local function fightCurrentTarget(target, anchored)
        local lastSnapAt = os.clock()
        local lastAttackAt = 0
        -- sweep reach: match the spot engagement radius in Stay in Spot (so
        -- everything it attacks is also catchable); TP mode keeps the
        -- tighter player-centered radius
        local catchRadius = (anchored and SPOT_RADIUS) or NEARBY_CATCH_RADIUS
        local label = (nameCache[target.model.Name] and nameCache[target.model.Name].name) or target.model.Name

        while farmActive() do
            if not clientMonsters:FindFirstChild(target.model.Name) then
                statusLbl.Text = "Status: " .. label .. " down (" .. (selectedMonster or "All") .. ")"
                return
            end

            -- current target got caught by the sweep: brief settle so the
            -- catch registers before a possible TP to the next target
            if completedTargets[target.model.Name] then
                waitChecked(0.5)
                return
            end

            -- Stay-in-Spot leash: drop targets that wander out of reach.
            if anchored then
                local root = target.model:FindFirstChild("Root") or target.model.PrimaryPart
                local pos = (root and root:IsA("BasePart")) and root.Position or nil
                if pos and (pos - anchored.Position).Magnitude > SPOT_RADIUS * 1.5 then
                    return
                end
            end

            -- attack cadence (SpamDelay), unchanged
            if os.clock() - lastAttackAt >= math.max(ATTACK_DELAY, 0.15) then
                lastAttackAt = os.clock()
                attackMonster(target.model)
            end

            -- independent V6-style fast catch sweep: does NOT wait for the
            -- current target to become catchable, catches every nearby
            -- catchable filtered monster NOW, and NEVER moves the player.
            -- Hard gate: while the boss loop owns a fight, the farm is
            -- paused anyway -- this is the belt for the suspenders so a
            -- manually-restarted farm can NEVER try to catch a boss target.
            if farmAutoCatchEnabled and not currentBossFight then
                for _, cand in ipairs(NoxarFindNearbyCatchableInfos(catchRadius)) do
                    local mid = cand.monsterId
                    if not (catchCooldowns[mid] and os.clock() < catchCooldowns[mid]) then
                        local started = NoxarStartCatchFromInfo(cand.info)
                        if started then
                            -- V6: long lockout -- MonsterCatchUtil completes
                            -- the animated catch by itself.
                            catchCooldowns[mid] = os.clock() + 20
                            completedTargets[cand.model.Name] = true
                            completed += 1
                            statusLbl.Text = "Status: Caught " .. completed .. " (" .. (selectedMonster or "All") .. ")"
                        else
                            catchCooldowns[mid] = os.clock() + 0.4
                        end
                    end
                end
            end

            -- Re-snap failsafe (TP mode): if we got flung/dragged off the
            -- target, snap back on top of it like the boss loop does.
            if not anchored and os.clock() - lastSnapAt >= 5 then
                lastSnapAt = os.clock()
                local root = target.model:FindFirstChild("Root")
                if root then glueToTarget(root) end
            end

            if not waitChecked(0.15) then return end
        end
    end

    -- Stay-in-Spot anchor: captured once per (re)start; the player is gently
    -- returned to it between engagements since catches can move the character.
    local anchorCFrame = nil
    local lastSeenMode = farmMode

    while farmActive() do
        -- mode switched mid-run (the Mode dropdown applies live): drop the
        -- stale Spot anchor so the new mode re-anchors/positions cleanly
        if farmMode ~= lastSeenMode then
            lastSeenMode = farmMode
            anchorCFrame = nil
        end

        -- forget completed instances that despawned (respawns get fresh ids)
        for name in pairs(completedTargets) do
            if not clientMonsters:FindFirstChild(name) then
                completedTargets[name] = nil
            end
        end

        -- drop expired catch lockouts (keeps the table bounded)
        local nowClock = os.clock()
        for mid, untilAt in pairs(catchCooldowns) do
            if nowClock >= untilAt then
                catchCooldowns[mid] = nil
            end
        end

        buildNameCache()
        local monsters = getTargetMonsters()

        if #monsters == 0 then
            statusLbl.Text = "Status: Waiting for spawns..."
            if not waitChecked(0.5) then break end
            continue
        end

        -- candidates: targetable monsters we haven't already completed
        local candidates = {}
        for _, m in ipairs(monsters) do
            if not completedTargets[m.model.Name] then
                table.insert(candidates, m)
            end
        end

        local target

        if farmMode == "Spot" then
            local r = getRoot()
            if not r then
                if not waitChecked(0.5) then break end
                continue
            end
            if not anchorCFrame then anchorCFrame = r.CFrame end

            -- closest candidate within SPOT_RADIUS of the anchor
            local bestDist = SPOT_RADIUS
            for _, m in ipairs(candidates) do
                local d = (m.pos - anchorCFrame.Position).Magnitude
                if d <= bestDist then
                    bestDist = d
                    target = m
                end
            end

            -- return to the anchor if the last fight/catch moved us
            if target and (r.Position - anchorCFrame.Position).Magnitude > 12 then
                r.CFrame = anchorCFrame
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        else
            target = candidates[1]
        end

        if not target then
            statusLbl.Text = (farmMode == "Spot")
                and ("Status: No targets near spot (" .. tostring(SPOT_RADIUS) .. " studs)...")
                or "Status: All current targets handled — waiting for respawns..."
            if not waitChecked(0.5) then break end
            continue
        end

        -- TP MODE ONLY: teleport onto the current target (one-shot snap,
        -- boss-style), then IMMEDIATELY unequip + re-equip the pets so they
        -- re-spawn on top of the new target instead of walking over from the
        -- previous spot. The unequip AND the equip both go through the
        -- game's own PetSystem client API (Equip Best or the selected Pet
        -- Team), so the game's pet/team UI refreshes live instead of going
        -- stale until a rejoin. The refresh fires unconditionally: the
        -- monstersEquipped flag can desync from real server state (manual
        -- equips, post-catch state, other features), and a skipped call
        -- would silently drop the whole refresh. No loops/connections are
        -- created -- this runs inline, once per target engagement, right
        -- after the teleport. Stay in Spot skips all of it (no TP, no
        -- equip/unequip at all).
        if farmMode ~= "Spot" then
            if target.root then
                glueToTarget(target.root)
            end
            NoxarPetUnEquipAll()
            if not waitChecked(EQUIP_DELAY) then break end
            if not clientMonsters:FindFirstChild(target.model.Name) then
                continue
            end
            NoxarEquipSelected()
            monstersEquipped = true
        end

        local label = (nameCache[target.model.Name] and nameCache[target.model.Name].name) or target.model.Name
        statusLbl.Text = "Status: Fighting " .. label .. "..."
        fightCurrentTarget(target, anchorCFrame)
    end

    unequipAll()
    -- Only write the final status if this is still the active run. A manual
    -- toggle-off bumps runId and already wrote "Status: Disabled" -- a
    -- cancelled/superseded loop must never overwrite that afterwards.
    if runId == myId then
        statusLbl.Text = "Status: Stopped. Completed: " .. completed
    end
end

ClaimStatus = nil
LastClaimLbl = nil

function claimEverything()
    if not autoClaimEnabled then
        return false
    end

    if ClaimStatus then
        ClaimStatus.Text = "Status: Claiming..."
    end

    -- Require fresh each time so the game's own UI listeners pick up the changes
    local TaskSystem, ChestRewardSystem, TowerSystem
    pcall(function() TaskSystem = require(RS.CommonLogic.Task.TaskSystem) end)
    pcall(function() ChestRewardSystem = require(RS.CommonLogic.ChestReward.ChestRewardSystem) end)
    pcall(function() TowerSystem = require(RS.CommonLogic.Tower.TowerSystem) end)

    -- Daily tasks (101-105)
    if TaskSystem then
        for _, id in ipairs({101, 102, 103, 104, 105}) do
            pcall(function() TaskSystem.ClientClaimReward(id) end)
            task.wait(0.15)
        end
        -- Weekly tasks (201-205)
        for _, id in ipairs({201, 202, 203, 204, 205}) do
            pcall(function() TaskSystem.ClientClaimReward(id) end)
            task.wait(0.15)
        end
    end

    -- Tower rewards
    if TowerSystem then
        pcall(function() TowerSystem.ClientTakeDailyRewardAll() end)
        task.wait(0.15)
        pcall(function() TowerSystem.ClientTakePrevSeasonRankReward() end)
        task.wait(0.15)
    end

    -- Daily chest + daily reward + member chest
    if ChestRewardSystem then
        pcall(function() ChestRewardSystem.ClientTakeDailyChest(1) end)
        task.wait(0.15)
        pcall(function() ChestRewardSystem.ClientTakeDailyReward(1) end)
        task.wait(0.15)
        pcall(function() ChestRewardSystem.ClientTakeMemberChest(1) end)
        task.wait(0.15)
    end

    if ClaimStatus then
        ClaimStatus.Text = "Status: Done!"
    end
    if LastClaimLbl then
        LastClaimLbl.Text = "Last claim: " .. os.date("%H:%M:%S")
    end

    return true
end

