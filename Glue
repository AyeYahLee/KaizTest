local TweenService = game:GetService("TweenService")

local function setSwitch(on)
    loopEnabled = on
    if on then
        TweenService:Create(switchBg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 90, 40)}):Play()
        TweenService:Create(switchKnob, TweenInfo.new(0.15), {Position = UDim2.new(1, -20, 0.5, -9)}):Play()
        setStatus("Starting...")
        startLoop()
    else
        loopId += 1 -- invalidate running loop
        TweenService:Create(switchBg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(70, 30, 30)}):Play()
        TweenService:Create(switchKnob, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -9)}):Play()
        setStatus("Stopped")
    end
end

switchBtn.MouseButton1Click:Connect(function()
    setSwitch(not loopEnabled)
end)

