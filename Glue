local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP = Character:WaitForChild("HumanoidRootPart")

local Remote = ReplicatedStorage
    :WaitForChild("CommonLibrary")
    :WaitForChild("Tool")
    :WaitForChild("RemoteManager")
    :WaitForChild("Funcs")
    :WaitForChild("DataPullFunc")

-- SETTINGS
local Difficulty = 1
local DungeonId = 1006
local TeamMode = 2

local Trigger = workspace.Area.center.ServerZone.Abyss.Abyss_1

local function Invoke(...)
    local ok, result = pcall(function(...)
        return Remote:InvokeServer(...)
    end, ...)
    if not ok then warn(result) end
    return ok, result
end

-- ══════════════════════════════
-- CORE LOOP LOGIC
-- ══════════════════════════════
local loopEnabled = false
local loopId = 0
local statusLbl -- set after GUI built

local function setStatus(text)
    if statusLbl then statusLbl.Text = text end
end

local function runAbyssCycle()
    setStatus("Teleporting...")
    HRP = Character and Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    HRP.CFrame = Trigger.CFrame + Vector3.new(0, 3, 0)
    task.wait(0.05)

    setStatus("Creating team...")
    Invoke("AbyssTeamCreatePrepareChannel", Difficulty)
    task.wait()

    Invoke("AbyssViewedTimeLimitedChannel", DungeonId)
    task.wait()

    Invoke("AbyssCreateTeamChannel", Difficulty, DungeonId, TeamMode)
    task.wait()

    Invoke("AbyssTeamCreatePrepareCancelChannel", Difficulty)
    task.wait()

    setStatus("Starting Abyss...")
    Invoke("AbyssStartChannel")

    task.wait(1.5)

    setStatus("Leaving Arena...")
    Invoke("ArenaLeaveChannel")

    setStatus("Cycle complete.")
end

local function startLoop()
    loopId += 1
    local myId = loopId
    task.spawn(function()
        while loopEnabled and loopId == myId do
            pcall(runAbyssCycle)
            task.wait(2)
            if not loopEnabled or loopId ~= myId then break end
        end
        if loopEnabled and loopId == myId then
            setStatus("Idle")
        end
    end)
end

