	if not isPress(i) then return end
	iconMoved = false
	local startPos, origin = i.Position, icon.Position
	beginDrag(i, function(pos)
		local d = pos - startPos
		if d.Magnitude > 8 then iconMoved = true end
		if iconMoved then
			icon.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
		end
	end)
end))
track(icon.MouseButton1Click:Connect(function()
	if iconMoved then return end
	icon.Visible = false
	main.Visible = true
end))

-- X = hide GUI into the icon (script keeps running)
track(closeBtn.MouseButton1Click:Connect(function()
	icon.Position = main.Position
	main.Visible = false
	icon.Visible = true
	updateIcon()
end))

-- ---- row helpers (every helper takes the page it should add to) ----
local order = 0
local function newRow(page, h, class)
	order += 1
	local r = Instance.new(class or "Frame")
	r.Size = UDim2.new(1, -8, 0, h)
	r.BackgroundColor3 = ROW
	r.BorderSizePixel = 0
	r.LayoutOrder = order
	r.Parent = page
	Instance.new("UICorner", r).CornerRadius = UDim.new(0, 8)
	return r
end

local function makeNote(page, text, h)
	local row = newRow(page, h or 40)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -16, 1, 0)
	lbl.Position = UDim2.fromOffset(8, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = DIM
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 11
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextYAlignment = Enum.TextYAlignment.Center
	lbl.Parent = row
end

local function makeToggle(page, labelTxt, key, onChange)
	local row = newRow(page, 34, "TextButton")
	row.Text = ""
	row.AutoButtonColor = false

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -60, 1, 0)
	lbl.Position = UDim2.fromOffset(10, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelTxt
	lbl.TextColor3 = TEXT
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 13
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local pill = Instance.new("Frame")
	pill.Size = UDim2.fromOffset(40, 20)
	pill.Position = UDim2.new(1, -48, 0.5, -10)
	pill.BorderSizePixel = 0
	pill.Parent = row
	Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(16, 16)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Parent = pill
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local function render()
		local v = cfg[key]
		pill.BackgroundColor3 = v and ACCENT or OFFCOL
		knob.Position = v and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
	end
	render()

	track(row.MouseButton1Click:Connect(function()
		cfg[key] = not cfg[key]
		render()
		scheduleSave()
		if onChange then onChange() end
	end))
	return render
end

local function makeModeSelector(page)
	local row = newRow(page, 42)
	local buttons = {}

	local function render()
		for mode, b in pairs(buttons) do
			b.BackgroundColor3 = (cfg.MODE == mode) and ACCENT or OFFCOL
		end
	end

	local function mk(txt, mode, left)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0.5, -8, 1, -10)
		b.Position = left and UDim2.new(0, 5, 0, 5) or UDim2.new(0.5, 3, 0, 5)
		b.Text = txt
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.GothamBold
		b.TextSize = 12
		b.BorderSizePixel = 0
		b.AutoButtonColor = false
		b.Parent = row
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
		buttons[mode] = b
		track(b.MouseButton1Click:Connect(function()
			cfg.MODE = mode
			render()
			lastReason = nil
			scheduleSave()
			if wakeNow then wakeNow() end
		end))
	end

	mk("On Cooldown", "cooldown", true)
	mk("Range Cast", "range", false)
	render()
end

local function makeSlider(page, labelTxt, key, fmt)
	local lim = LIMITS[key]
	local minV, maxV, step = lim.min, lim.max, lim.step
	local row = newRow(page, 54)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -80, 0, 22)
	lbl.Position = UDim2.fromOffset(10, 4)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelTxt
	lbl.TextColor3 = TEXT
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 13
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local box = Instance.new("TextBox")
	box.Size = UDim2.fromOffset(58, 22)
	box.Position = UDim2.new(1, -66, 0, 4)
	box.BackgroundColor3 = Color3.fromRGB(14, 14, 20)
	box.TextColor3 = ACCENT
	box.Font = Enum.Font.GothamBold
	box.TextSize = 13
	box.ClearTextOnFocus = true
	box.BorderSizePixel = 0
	box.Parent = row
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

	local hit = Instance.new("Frame")
	hit.Size = UDim2.new(1, -20, 0, 24)
	hit.Position = UDim2.fromOffset(10, 28)
	hit.BackgroundTransparency = 1
	hit.Active = true
	hit.Parent = row

	local track_ = Instance.new("Frame")
	track_.Size = UDim2.new(1, 0, 0, 6)
	track_.Position = UDim2.new(0, 0, 0.5, -3)
	track_.BackgroundColor3 = OFFCOL
	track_.BorderSizePixel = 0
	track_.Parent = hit
	Instance.new("UICorner", track_).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = ACCENT
	fill.BorderSizePixel = 0
	fill.Parent = track_
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local function apply(v, silent)
		v = math.clamp(v, minV, maxV)
		v = math.floor(v / step + 0.5) * step
		v = math.clamp(v, minV, maxV)
		cfg[key] = v
		fill.Size = UDim2.new((v - minV) / (maxV - minV), 0, 1, 0)
		box.Text = string.format(fmt, v)
		if not silent then scheduleSave() end
	end
	apply(cfg[key], true)

	local function fromX(x)
		local pct = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
		apply(minV + pct * (maxV - minV))
	end

	track(hit.InputBegan:Connect(function(i)
		if not isPress(i) then return end
		page.ScrollingEnabled = false
		lockedPage = page
		fromX(i.Position.X)
		beginDrag(i, function(pos) fromX(pos.X) end)
	end))

	track(box.FocusLost:Connect(function()
		local v = tonumber(box.Text)
		if v then apply(v) else box.Text = string.format(fmt, cfg[key]) end
	end))
end

