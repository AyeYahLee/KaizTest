	local ok, data = pcall(function()
		if isfile(SAVE_FILE) then return HttpService:JSONDecode(readfile(SAVE_FILE)) end
		return nil
	end)
	if ok and type(data) == "table" then saved = data end
end

local function clampNum(v, lim, def)
	if isNum(v) then return math.clamp(v, lim.min, lim.max) end
	return def
end
if saved then
	cfg.ENABLED = saved.ENABLED == true
	if saved.MODE == "cooldown" or saved.MODE == "range" then cfg.MODE = saved.MODE end
	cfg.REQUIRE_ARENA = saved.REQUIRE_ARENA == true
	cfg.RANGE = clampNum(saved.RANGE, LIMITS.RANGE, cfg.RANGE)
	cfg.MARGIN = clampNum(saved.MARGIN, LIMITS.MARGIN, cfg.MARGIN)
	cfg.KILL_AURA = saved.KILL_AURA == true
	cfg.AURA_MELEE = clampNum(saved.AURA_MELEE, LIMITS.AURA_MELEE, cfg.AURA_MELEE)
	cfg.AURA_ARCHER = clampNum(saved.AURA_ARCHER, LIMITS.AURA_ARCHER, cfg.AURA_ARCHER)
	cfg.ANTI_AFK = saved.ANTI_AFK == true
	cfg.DEBUG = saved.DEBUG == true
end

-- ============ remotes (with timeout so it can't hang) ============
