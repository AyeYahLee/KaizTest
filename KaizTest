-- ── Module Loading ──
local ClickSystem = nil
pcall(function() ClickSystem = require(RS.CommonLogic.PlayerDamage.ClickSystem) end)

local function doTick()
    -- Method 1: Game's own module (triggers client-side display update)
    if ClickSystem and ClickSystem.ClientAddPlayerDamage then
        local ok = pcall(function() ClickSystem.ClientAddPlayerDamage() end)
        if ok then return true end
    end
    -- Method 2: _G.PathTool (if loaded)
    if _G.PathTool and _G.PathTool.ClickSystem and _G.PathTool.ClickSystem.ClientAddPlayerDamage then
        local ok = pcall(function() _G.PathTool.ClickSystem.ClientAddPlayerDamage() end)
        if ok then return true end
    end
    -- Method 3: Raw remote (works but no live display)
    pcall(function()
        DataPullFunc:InvokeServer("AddPlayerDamageChannel", true)
    end)
    return true
end

-- ── Tick Loop ──
task.spawn(function()
    while sg.Parent do
        if enabled then
            doTick()
            hits += 1
            statsLbl.Text = "Hits: " .. hits
        end
        task.wait(delay)
    end
end)

print("[FastTick] Loaded — toggle ON to start ticking")
