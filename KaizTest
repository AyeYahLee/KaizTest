-- one shared drag system (window + icon + sliders), one pair of connections total
local active, lockedPage
local function beginDrag(input, moveFn) active = { input = input, move = moveFn } end
local function endDrag()
	active = nil
	if lockedPage then
		lockedPage.ScrollingEnabled = true
		lockedPage = nil
	end
end

track(UIS.InputChanged:Connect(function(i)
	if active and (i == active.input or i.UserInputType == Enum.UserInputType.MouseMovement) then
		active.move(i.Position)
	end
end))
track(UIS.InputEnded:Connect(function(i)
	if active and (i == active.input or (i.UserInputType == Enum.UserInputType.MouseButton1
		and active.input.UserInputType == Enum.UserInputType.MouseButton1)) then
		endDrag()
	end
end))

track(UIS.WindowFocusReleased:Connect(endDrag))

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1
end

-- drag window by title bar
track(titleBar.InputBegan:Connect(function(i)
	if not isPress(i) then return end
	local startPos, origin = i.Position, main.Position
	beginDrag(i, function(pos)
		local d = pos - startPos
		main.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
	end)
end))

