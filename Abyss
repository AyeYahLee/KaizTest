-- POINTS TRACKER
-- ══════════════════════════════════════════════════════════════════
local POINTS_PER_CYCLE = 30
local totalPoints = 0
local totalCycles = 0

local function fmtPoints(n)
    if n >= 1000000 then
        return string.format("%.1fM", n / 1000000)
    elseif n >= 1000 then
        return string.format("%.1fk", n / 1000)
    end
    return tostring(n)
end

-- ══════════════════════════════════════════════════════════════════
-- AUTO REJOIN
-- ══════════════════════════════════════════════════════════════════
local autoRejoinEnabled = false
local rejoinAtCycles = 20

local function rejoinSameServer()
    local ok, joinData = pcall(function() return LP:GetJoinData() end)
    local code = ok and joinData and joinData.PrivateServerAccessCode
    task.wait(2)
    if code and code ~= "" then
        pcall(function() TeleportService:TeleportToPrivateServer(game.PlaceId, code, {LP}) end)
    else
        pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
    end
end

-- ══════════════════════════════════════════════════════════════════
-- SAVE / LOAD (persists across rejoins)
-- ══════════════════════════════════════════════════════════════════
local SAVE_FILE = "AbyssAllInOneSave.json"

-- State (declared before loadSettings so save/load works)
local hostEnabled = false
local joinerEnabled = false
local busy = false
local stopped = false

-- Reset cycles/points on fresh load (rejoin)
totalCycles = 0
totalPoints = 0

local function saveSettings()
    if not writefile then return end
    pcall(function()
        local data = {
            hostEnabled = hostEnabled,
            autoRejoinEnabled = autoRejoinEnabled,
            rejoinAtCycles = rejoinAtCycles
        }
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

local function loadSettings()
    if not (isfile and readfile and isfile(SAVE_FILE)) then return end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(SAVE_FILE))
        if data.hostEnabled ~= nil then hostEnabled = data.hostEnabled end
        if data.autoRejoinEnabled ~= nil then autoRejoinEnabled = data.autoRejoinEnabled end
        if data.rejoinAtCycles ~= nil then rejoinAtCycles = data.rejoinAtCycles end
    end)
end

loadSettings()

