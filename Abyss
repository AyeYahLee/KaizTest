-- Failsafe Thread
local START_POS = Vector3.new(583.272, 3472.545, -549.761)
local targetHeight = 3.225

trackThread(function()
    while not stopped do
        task.wait(5)
        if not hostEnabled then continue end

        if os.clock() - lastStatusTime >= 30 then
            if HRP then
                setStatus("Stuck — TP back!", Color3.fromRGB(255, 100, 100))
                HRP.CFrame = CFrame.new(START_POS + Vector3.new(0, 5, 0))
                HRP.AssemblyLinearVelocity = Vector3.zero
            end
            lastStatusTime = os.clock()
        end
    end
end)

-- Host Thread
trackThread(function()
    while not stopped do
        task.wait(1)
        if not hostEnabled then continue end
        
        -- Validate Trigger Exists (Kept this so it doesn't crash your script entirely!)
        if not Trigger then
            setStatus("Error: Trigger missing", Color3.fromRGB(255, 100, 100))
            Trigger = getTrigger()
            task.wait(3)
            continue
        end

        local atStart = false
        while hostEnabled and not stopped do
            if HRP then
                -- REVERTED TO ORIGINAL VALIDATION LOGIC
                local dist = (HRP.Position - START_POS).Magnitude
                local heightAboveGround = HRP.Position.Y - (START_POS.Y - targetHeight)
                
                if dist < 8 and math.abs(heightAboveGround - targetHeight) < 1 then
                    atStart = true
                    break
                end
            end
            task.wait(0.5)
        end

        if not atStart or not hostEnabled or stopped then continue end

        if HRP and Trigger then
            HRP.CFrame = Trigger.CFrame + Vector3.new(0, 3, 0)
        end
        task.wait(0.5)

        setStatus("Creating team...")
        if not SafeInvoke("AbyssCreateTeamChannel", 1, 1006, 2) then
            setStatus("Failed to create team", Color3.fromRGB(255, 100, 100))
            task.wait(2)
            continue
        end
        
        task.wait(0.5)
        setStatus("Starting Abyss...")
        if not SafeInvoke("AbyssStartChannel") then
            setStatus("Failed to start abyss", Color3.fromRGB(255, 100, 100))
            task.wait(2)
            continue
        end

        task.wait(1)
        setStatus("Leaving Arena...")
        SafeInvoke("ArenaLeaveChannel")

        -- Successfully completed loop
        totalCycles += 1
        totalPoints += POINTS_PER_CYCLE
        pointsLbl.Text = "Points: " .. fmtPoints(totalPoints)
        updateRejoinProgress()

        if autoRejoinEnabled and totalCycles >= rejoinAtCycles then
            setStatus("Rejoining...", Color3.fromRGB(255, 200, 80))
            local ok, joinData = pcall(function() return LP:GetJoinData() end)
            local code = ok and joinData and joinData.PrivateServerAccessCode
            task.wait(1)
            
            pcall(function()
                if code and code ~= "" then
                    TeleportService:TeleportToPrivateServer(game.PlaceId, code, {LP})
                else
                    TeleportService:Teleport(game.PlaceId, LP)
                end
            end)
            task.wait(10) -- Pause while teleporting
            continue
        end

        setStatus("Cycle done", Color3.fromRGB(100, 255, 130))
    end
end)

