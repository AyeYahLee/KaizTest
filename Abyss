local activeConnections = {}
local activeThreads = {}
local stopped = false

local function trackConnection(conn)
    table.insert(activeConnections, conn)
    return conn
end

local function trackThread(func)
    local thread = task.spawn(func)
    table.insert(activeThreads, thread)
    return thread
end

_G.StopAbyssLooper = function()
    stopped = true
    for _, conn in ipairs(activeConnections) do
        conn:Disconnect()
    end
    for _, t in ipairs(activeThreads) do
        pcall(task.cancel, t)
    end
    table.clear(activeConnections)
    table.clear(activeThreads)
    
    local oldGui = LP.PlayerGui:FindFirstChild("AbyssLooperGui")
    if oldGui then oldGui:Destroy() end
end

