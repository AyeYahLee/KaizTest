local SAVE_FILE = "AbyssLooperSave.json"
local POINTS_PER_CYCLE = 30
local totalPoints = 0
local totalCycles = 0

local hostEnabled = false
local autoRejoinEnabled = false
local rejoinAtCycles = 20
local antiAfkEnabled = false

local function saveSettings()
    if not writefile then return end
    pcall(function()
        local data = {
            hostEnabled = hostEnabled,
            autoRejoinEnabled = autoRejoinEnabled,
            rejoinAtCycles = rejoinAtCycles,
            antiAfkEnabled = antiAfkEnabled
        }
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

local function loadSettings()
    if not (isfile and readfile and isfile(SAVE_FILE)) then return end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(SAVE_FILE))
        if data.hostEnabled ~= nil then hostEnabled = data.hostEnabled end
        if data.autoRejoinEnabled ~= nil then autoRejoinEnabled = data.autoRejoinEnabled end
        if data.rejoinAtCycles ~= nil then rejoinAtCycles = data.rejoinAtCycles end
        if data.antiAfkEnabled ~= nil then antiAfkEnabled = data.antiAfkEnabled end
    end)
end

loadSettings()

local function fmtPoints(n)
    if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
    if n >= 1000 then return string.format("%.1fk", n / 1000) end
    return tostring(n)
end

