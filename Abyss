-- Toggle helper
local function makeToggle(parent, label, yOffset, onToggle)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -16, 0, 24)
    row.Position = UDim2.new(0, 8, 0, yOffset)
    row.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -52, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(220, 220, 225)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local bg = Instance.new("Frame", row)
    bg.Size = UDim2.new(0, 44, 0, 20)
    bg.Position = UDim2.new(1, -44, 0.5, -10)
    bg.BackgroundColor3 = Color3.fromRGB(70, 30, 30)
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", bg)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 2, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton", bg)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""

    local state = false

    local function set(on)
        state = on
        if on then
            TweenService:Create(bg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 90, 40)}):Play()
            TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
        else
            TweenService:Create(bg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(70, 30, 30)}):Play()
            TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
        end
        onToggle(on)
    end

    btn.MouseButton1Click:Connect(function()
        set(not state)
    end)

    return { set = set, getState = function() return state end }
end

-- Host toggle
local hostToggle = makeToggle(main, "🌀 Host Mode (create teams)", 48, function(on)
    hostEnabled = on
    if on then
        -- Disable joiner
        if joinerEnabled then
            joinerEnabled = false
            joinerToggle.set(false)
        end
        setStatus("Host: starting...", Color3.fromRGB(100, 220, 255))
    else
        setStatus("Host: stopped", Color3.fromRGB(140, 140, 160))
    end
end)

-- Joiner toggle
local joinerToggle = makeToggle(main, "🎯 Joiner Mode (join teams)", 76, function(on)
    joinerEnabled = on
    busy = false
    if on then
        -- Disable host
        if hostEnabled then
            hostEnabled = false
            hostToggle.set(false)
        end
        setStatus("Joiner: scanning...", Color3.fromRGB(100, 255, 130))
    else
        setStatus("Joiner: stopped", Color3.fromRGB(140, 140, 160))
    end
end)

