    local knob = Instance.new("Frame", bg)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 2, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton", bg)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""

    local state = false
    local function set(on)
        state = on
        local color = on and Color3.fromRGB(30, 90, 40) or Color3.fromRGB(70, 30, 30)
        local pos = on and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        
        TweenService:Create(bg, TweenInfo.new(0.15), {BackgroundColor3 = color}):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {Position = pos}):Play()
        onToggle(on)
    end

    trackConnection(btn.MouseButton1Click:Connect(function() set(not state) end))
    return { set = set }
end

