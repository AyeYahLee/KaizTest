-- ══════════════════════════════════════════════════════════════════
-- FAILSAFE: teleport back if stuck on same status for 30s
-- ══════════════════════════════════════════════════════════════════
local START_POS = Vector3.new(583.272, 3472.545, -549.761)
local STUCK_TIMEOUT = 30
local lastStatusText = ""
local lastStatusTime = os.clock()

-- Override setStatus to track changes
local originalSetStatus = setStatus
setStatus = function(text, color)
    if text ~= lastStatusText then
        lastStatusText = text
        lastStatusTime = os.clock()
    end
    originalSetStatus(text, color)
end

task.spawn(function()
    while not stopped do
        task.wait(1)
        if not hostEnabled then continue end

        if os.clock() - lastStatusTime >= STUCK_TIMEOUT then
            local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if root then
                setStatus("Stuck — TP back!", Color3.fromRGB(255, 100, 100))
                root.CFrame = CFrame.new(START_POS + Vector3.new(0, 5, 0))
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                lastStatusTime = os.clock()
            end
        end
    end
end)

-- ══════════════════════════════════════════════════════════════════
-- HOST LOOP
-- ══════════════════════════════════════════════════════════════════
task.spawn(function()
    while not stopped do
        task.wait(1)
        if not hostEnabled then continue end

        -- Wait until character is at the starting position
        local startPos = Vector3.new(583.272, 3472.545, -549.761)
        local targetHeight = 3.225
        local atStart = false
        while hostEnabled and not stopped do
            local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (root.Position - startPos).Magnitude
                local heightAboveGround = root.Position.Y - (startPos.Y - targetHeight)
                if dist < 8 and math.abs(heightAboveGround - targetHeight) < 1 then
                    atStart = true
                    break
                end
            end
            task.wait(0.2)
        end

        if not atStart or not hostEnabled or stopped then continue end

        -- Teleport to portal
        HRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not HRP then continue end
        HRP.CFrame = Trigger.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.1)

        -- Create team
        setStatus("Creating team...")
        Invoke("AbyssTeamCreatePrepareChannel", Difficulty)
        task.wait()

        Invoke("AbyssViewedTimeLimitedChannel", DungeonId)
        task.wait()

        Invoke("AbyssCreateTeamChannel", Difficulty, DungeonId, TeamMode)
        task.wait()

        Invoke("AbyssTeamCreatePrepareCancelChannel", Difficulty)
        task.wait()

        -- Start
        setStatus("Starting Abyss...")
        Invoke("AbyssStartChannel")
        task.wait(0.5)

        -- Leave
        setStatus("Leaving Arena...")
        Invoke("ArenaLeaveChannel")
        task.wait(0.5)

        -- Track points
        totalCycles += 1
        totalPoints += POINTS_PER_CYCLE
        pointsLbl.Text = "Points: " .. fmtPoints(totalPoints)
        updateRejoinProgress()
        saveSettings()

        -- Check auto rejoin
        if autoRejoinEnabled and totalCycles >= rejoinAtCycles then
            setStatus("Rejoining...", Color3.fromRGB(255, 200, 80))
            -- Save with hostEnabled = true so it auto-starts after rejoin
            saveSettings()
            rejoinSameServer()
            continue
        end

        setStatus("Host: cycle done", Color3.fromRGB(100, 255, 130))
    end
end)

-- ══════════════════════════════════════════════════════════════════
-- JOINER LOOP
-- ══════════════════════════════════════════════════════════════════
task.spawn(function()
    while not stopped do
        task.wait(0.2)
        if not joinerEnabled then continue end

        -- In Abyss — monitor for host leaving
        if isInAbyss() then
            setStatus("Joiner: in Abyss!", Color3.fromRGB(100, 255, 130))
            while joinerEnabled and not stopped and isInAbyss() do
                local teammates = 0
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LP and player:GetAttribute("AbyssSyncKey") ~= nil then
                        teammates += 1
                    end
                end
                if teammates == 0 then
                    setStatus("Joiner: alone — leaving!", Color3.fromRGB(255, 100, 100))
                    leaveArena()
                    break
                end
                task.wait(0.3)
            end
            if joinerEnabled then
                task.wait(1)
                setStatus("Joiner: scanning...", Color3.fromRGB(100, 220, 130))
            end
            continue
        end

        -- Not in Abyss — try joining
        if busy then continue end
        busy = true

        local joinOk, joinResult = pcall(function()
            return DataPullFunc:InvokeServer("AbyssJoinTeamChannel", 1)
        end)

        task.wait(0.1)
        if isInAbyss() then
            setStatus("Joiner: joined!", Color3.fromRGB(100, 255, 130))
            busy = false
            continue
        end

        if joinOk and joinResult ~= false then
            setStatus("Joiner: team found — joining...", Color3.fromRGB(100, 220, 255))
            teleportToAbyss()
            task.wait(0.5)
            if not joinerEnabled then busy = false; continue end

            for attempt = 1, 3 do
                if isInAbyss() then break end
                pcall(function()
                    DataPullFunc:InvokeServer("AbyssJoinTeamChannel", 1)
                end)
                task.wait(0.3)
            end

            if isInAbyss() then
                setStatus("Joiner: joined!", Color3.fromRGB(100, 255, 130))
            else
                setStatus("Joiner: failed — retrying...", Color3.fromRGB(255, 150, 80))
            end
        end

        busy = false
    end
end)

