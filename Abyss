-- Abyss All-In-One — Host + Joiner in one UI
-- Two toggles: Host Mode (creates teams) and Joiner Mode (joins teams).
-- Only one can be active at a time.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local LP = Players.LocalPlayer

local DataPullFunc = RS:WaitForChild("CommonLibrary"):WaitForChild("Tool")
    :WaitForChild("RemoteManager"):WaitForChild("Funcs"):WaitForChild("DataPullFunc")

local Character = LP.Character or LP.CharacterAdded:Wait()
local HRP = Character:WaitForChild("HumanoidRootPart")

-- ══════════════════════════════════════════════════════════════════
-- SETTINGS
-- ══════════════════════════════════════════════════════════════════
local Difficulty = 1
local DungeonId = 1005
local TeamMode = 2
local Trigger = workspace.Area.center.ServerZone.Abyss.Abyss_1

-- State
local hostEnabled = false
local joinerEnabled = false
local busy = false
local stopped = false

-- ══════════════════════════════════════════════════════════════════
-- HELPERS
-- ══════════════════════════════════════════════════════════════════
local function Invoke(...)
    local ok, result = pcall(function(...)
        return DataPullFunc:InvokeServer(...)
    end, ...)
    return ok, result
end

local function isInAbyss()
    local ok, key = pcall(function() return LP:GetAttribute("AbyssSyncKey") end)
    return ok and key ~= nil
end

local function teleportToAbyss()
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if root and Trigger then
        root.CFrame = Trigger.CFrame + Vector3.new(0, 3, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function leaveArena()
    Invoke("ArenaLeaveChannel")
end

-- ══════════════════════════════════════════════════════════════════
