local function getTrigger()
    local area = workspace:FindFirstChild("Area") or workspace:WaitForChild("Area", 10)
    if not area then return nil end
    
    local center = area:WaitForChild("center", 5)
    if not center then return nil end
    
    local sz = center:WaitForChild("ServerZone", 5)
    if not sz then return nil end
    
