-- ══════════════════════════════════════════════════════════════════
-- HOST LOOP
-- ══════════════════════════════════════════════════════════════════
task.spawn(function()
    while not stopped do
        task.wait(0.5)
        if not hostEnabled then continue end

        -- Teleport to portal
        setStatus("Host: teleporting...", Color3.fromRGB(255, 200, 80))
        HRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not HRP then continue end
        HRP.CFrame = Trigger.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.05)

        -- Create team
        setStatus("Host: creating team...", Color3.fromRGB(255, 200, 80))
        Invoke("AbyssTeamCreatePrepareChannel", Difficulty)
        task.wait(0.1)
        Invoke("AbyssViewedTimeLimitedChannel", DungeonId)
        task.wait(0.2)
        Invoke("AbyssCreateTeamChannel", Difficulty, DungeonId, TeamMode)
        task.wait(0.3)
        Invoke("AbyssTeamCreatePrepareCancelChannel", Difficulty)
        task.wait(0.5)

        -- Wait for joiner near portal
        setStatus("Host: waiting for teammate...", Color3.fromRGB(200, 200, 120))
        local waitStart = os.clock()
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        while hostEnabled and os.clock() - waitStart < 30 do
            local found = false
            if myRoot then
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LP then
                        local theirChar = player.Character
                        local theirRoot = theirChar and theirChar:FindFirstChild("HumanoidRootPart")
                        if theirRoot and (myRoot.Position - theirRoot.Position).Magnitude < 13 then
                            found = true
                            break
                        end
                    end
                end
            end
            if found then break end
            task.wait(0.2)
        end

        if not hostEnabled then continue end

        -- Start
        setStatus("Host: starting Abyss...", Color3.fromRGB(100, 255, 130))
        Invoke("AbyssStartChannel")
        task.wait(1.5)

        -- Leave
        setStatus("Host: leaving...", Color3.fromRGB(255, 200, 80))
        Invoke("ArenaLeaveChannel")
        task.wait(2)

        setStatus("Host: cycle done", Color3.fromRGB(100, 255, 130))
    end
end)

-- ══════════════════════════════════════════════════════════════════
-- JOINER LOOP
-- ══════════════════════════════════════════════════════════════════
task.spawn(function()
    while not stopped do
        task.wait(0.2)
        if not joinerEnabled then continue end

        -- In Abyss — monitor for host leaving
        if isInAbyss() then
            setStatus("Joiner: in Abyss!", Color3.fromRGB(100, 255, 130))
            while joinerEnabled and not stopped and isInAbyss() do
                -- Check if any other player is still in the Abyss
                local teammates = 0
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LP and player:GetAttribute("AbyssSyncKey") ~= nil then
                        teammates += 1
                    end
                end
                if teammates == 0 then
                    setStatus("Joiner: alone — leaving!", Color3.fromRGB(255, 100, 100))
                    leaveArena()
                    break
                end
                task.wait(0.3)
            end
            if joinerEnabled then
                task.wait(1)
                setStatus("Joiner: scanning...", Color3.fromRGB(100, 220, 130))
            end
            continue
        end

        -- Not in Abyss — try joining
        if busy then continue end
        busy = true

        local joinOk, joinResult = pcall(function()
            return DataPullFunc:InvokeServer("AbyssJoinTeamChannel", 1)
        end)

        task.wait(0.1)
        if isInAbyss() then
            setStatus("Joiner: joined!", Color3.fromRGB(100, 255, 130))
            busy = false
            continue
        end

        if joinOk and joinResult ~= false then
            setStatus("Joiner: team found — joining...", Color3.fromRGB(100, 220, 255))
            teleportToAbyss()
            task.wait(0.5)
            if not joinerEnabled then busy = false; continue end

            for attempt = 1, 3 do
                if isInAbyss() then break end
                pcall(function()
                    DataPullFunc:InvokeServer("AbyssJoinTeamChannel", 1)
                end)
                task.wait(0.3)
            end

            if isInAbyss() then
                setStatus("Joiner: joined!", Color3.fromRGB(100, 255, 130))
            else
                setStatus("Joiner: failed — retrying...", Color3.fromRGB(255, 150, 80))
            end
        end

        busy = false
    end
end)

-- Cleanup
if _G.StopAbyssAllInOne then _G.StopAbyssAllInOne() end
_G.StopAbyssAllInOne = function()
    stopped = true
    hostEnabled = false
    joinerEnabled = false
    busy = false
    if sg then sg:Destroy() end
end

